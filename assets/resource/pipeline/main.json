{
    // ★ 纯 JSON 重构（2026-09-23）：入口 / 环境准备 / 对战主循环。
    //   字段名对着官方《3.1-任务流水线协议》核过，不是猜的：
    //     StartApp/StopApp 的包名参数是 `package`；Shell 是 `cmd`；
    //     Click 的 `target` 默认 true（点识别框中心）；`max_hit` 超限后会被 next 跳过。
    //   圣水/塔血的阈值来自真机标定（见 纯JSON化设计-含标定.md 第一节）。
    //
    // ⚠️ 两个任务的入口必须各不相同（共用入口的那个在界面上不显示），
    //    但它们**共用同一条环境准备链**；区别靠 interface.json 的**任务级
    //    pipeline_override** 注入：
    //      「启动游戏」—— 准备完就结束（主界面锚点 next 为空）
    //      「自动战斗」—— 准备完继续进对战循环（override 成 next: [对战循环入口]）
    // ══════════ 未登录守卫（2026-10-11）══════════
    // 每个任务的**入口 next 第一位**都挂上「登录页」，让它当守卫。
    // 目的：游戏掉登录态时，**当前任务判失败并通知**，而且**后面的任务什么也不做**。
    //
    // 为什么不能只靠「清障链里那个登录页」：
    //   · 清障链里的那个只能拦住「已经走到了环境准备」的任务；而 `StopTask` 是**成功**，
    //     客户端看到「任务完成」就把队列里下一个任务接着跑起来 —— 于是每个任务都要
    //     重新拉起游戏、再走一遍启动链，最后才轮到登录页，白折腾一遍还看不到「失败」。
    //   · 挂在入口第一位就变成：一进来先看一眼是不是登录页 —— 是 → 立刻判失败（约 1 秒），
    //     不是（正常情况）→ 一个 TemplateMatch 的代价，然后照常走「环境准备」。
    // 安全性（必须全屏搜、必须不假命中，因为动不动就废一整天）：
    //   2026-10-11 全量复验 tools/verify_login_guard.py：
    //   正样本（720x1280 登录页实拍）**1.0000**；318 张真实界面帧（负样本）
    //   最高只有 **0.3238**（阈值 0.8）。两侧余量都很大。
    //   （另用 2026-10-11 的手机截图等比复算，仍能到 0.9661 ⇒ 模板没过时。）
    //   判据用了**两个特征**（徽章 + 登录按钮），见下面 `登录页` 节点。
    "启动游戏": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "登录页",
            "环境准备"
        ]
    },
    "启动检查": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "next": [
            "登录页",
            "环境准备"
        ]
    },
    // 环境准备：点屏常亮 -> 拉起游戏 -> 清障 -> 等主界面。
    // 「多久没到主界面就报失败」靠 `再等等` 的 max_hit 当**重试预算**：
    // 60 次 × post_delay 2000 = 最多等 120 秒；用完就被 next 跳过，
    // 那时既没有清障项可点、也没到主界面 -> 清障链 识别超时 -> on_error 报失败。
    "环境准备": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "input keyevent KEYCODE_WAKEUP; svc power stayon true"
            }
        },
        "post_delay": 800,
        "next": [
            "拉起游戏"
        ],
        "on_error": [
            "环境未就绪"
        ]
    },
    "拉起游戏": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.tencent.tmgp.supercell.clashroyale"
            }
        },
        "post_delay": 3000,
        "next": [
            "清障链"
        ],
        "on_error": [
            "环境未就绪"
        ]
    },
    // 清障链：等启动过程中的加载/弹层过去，直到出现主界面锚点。
    // ⚠️ 顺序是踩出来的（22:06 实测）：**主界面锚点必须排在「再等等」前面**。
    //    「再等等」是 DirectHit、永远命中，排在前面就会把锚点饿死 ——
    //    框架日志里表现为 清障链 → 再等等 → 清障链 → 再等等 无限互相调用，
    //    锚点一次都没被评估过。
    // ⚠️ timeout 给短（5 秒）：重试预算用完后（「再等等」被 max_hit 跳过）
    //    这里识别不到东西，尽快落到 on_error 报失败。
    // ⚠️ 「登录页」必须排在这里才**真的会被判到**（2026-09-23 修）：
    //    它以前只在「对战循环入口」的 next 里 —— 那已经是进主界面之后了，
    //    登录页根本不可能出现在那儿，等于死链。放到启动链里才是它该在的位置。
    //    顺序放在「主界面锚点」**后面**：先确认真的进游戏了，再怀疑没登录。
    // ⚠️ 「[JumpBack]关掉卡牌已收到弹窗」必须排在最前（2026-09-24 补）：
    //    「卡牌已收到！」弹窗带半透明遮罩，会把主界面锚点的橙色压到 count=0、
    //    nav/battle 压到 0.44，下面几个锚点全都判不出来 —— 实测能让清障链空转
    //    满 60 轮（约 120 秒）后报「环境未就绪」。它用 [JumpBack]，关完自动回来
    //    重新识别本列表，不需要额外的返回路径。
    // TODO（需要真实启动帧才能补）：国服启动时的「公告 / 活动弹窗」关闭节点。
    //   如果实测发现弹窗挡住了主界面按钮，就照这个位置补两个关闭节点（模板从启动帧裁）。
    "清障链": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "timeout": 5000,
        "on_error": [
            "环境未就绪"
        ],
        "next": [
            "[JumpBack]关掉卡牌已收到弹窗",
            "[JumpBack]关掉奖励弹屏",
            "点掉挡路弹窗",
            "启动-关奖励宝箱",
            "主界面锚点",
            "启动-回主界面",
            "启动-从部落战页回主界面",
            "登录页",
            "再等等"
        ]
    },
    // ⚠️ 「启动-关奖励宝箱」必须排在「主界面锚点」**前面**（2026-09-24 实测踩到）：
    //    开宝箱那一屏是**整屏橙色背景** + 中间一个「?」宝箱 + 顶部两颗星。
    //    而「主界面锚点」判的是「橙色 ColorMatch」，于是它在那屏上**误命中**
    //    （roi 整格 count=16000，直接过阈值 8000）—— 框架以为已经到主界面，
    //    就往下走了，后面的步骤全在错的屏上瞎撞。
    //    实测：一条龙启动时游戏正好停在开宝箱动画上，锚点误判 →
    //    「商店去商店页」连试 21 次（0.2882）→ 20 秒后任务 Failed。
    // 模板是用「真的能命中」重新标的（2026-09-24 第二次修）：
    //    原来照抄「奖励宝箱」的 chest_stars.png / chest_stars_b.png（两张现已删除）—— 实测在
    //    三张橙屏截图上最高只有 **0.571**（阈值 0.85），即**从来没生效过**，
    //    等于这个节点白加。现在换成从橙屏实测裁出来的两个特征：
    //      chest_orange_stars.png  顶部两颗星   正样本 ≥0.9985 / 负样本 ≤0.5750
    //      chest_orange_slots.png  底部4个「?」圈 正样本 ≥0.8163 / 负样本 ≤0.3038
    //    两个特征互相兜底（防动画某一帧某特征变淡），阈值 0.8。
    // 自环 + 关完回清障链（对战循环那份的续接是对战循环入口，所以另开一个节点）。
    // max_hit 当跑飞的保险丝，timeout 给 1 秒避免画面已经变了还在等。
    "启动-关奖励宝箱": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["anchors/chest_orange_stars.png", "anchors/chest_orange_slots.png"],
                "threshold": 0.8
            }
        },
        "action": {"type": "Click", "param": {"target": [360, 600]}},
        "post_delay": 1500,
        "timeout": 1000,
        "max_hit": 300,
        "next": ["启动-关奖励宝箱"],
        "on_error": ["清障链"]
    },
    // 「游戏还停在某个子页面」时的救回：直接点底部导航的「对战」。
    // ⚠️ 为什么必须有这个节点（2026-09-23 实测踩到）：
    //    「主界面锚点」认的是主界面上那片橙色「对战」按钮。如果上一次跑完把游戏
    //    留在**商店页 / 部落页 / 卡组页**，那片橙色根本不在屏幕上 —— 锚点永远不中，
    //    清障链就会一路「再等等」把预算磨完，然后报「环境未就绪」。
    //    实测：从商店页起跑，清障链空转了 56 轮（≈110 秒）才被掐掉。
    //    底部导航条在子页面里是**可见**的（对战那一格是未选中态），所以点一下就能回去。
    // ⚠️ 顺序放在「主界面锚点」**后面**：先确认真在主界面了，再考虑要不要点导航。
    "启动-回主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/battle.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "清障链"
        ]
    },
    // 关「挡路的弹窗」：2026-09-23 实测到的真实场景 —— 奖杯之路 / 解锁卡牌那种
    // 全屏奖励弹窗，上面没有「对战」按钮，主界面锚点永远匹配不到，
    // 整个启动阶段就会一直等到超时。实测截图里底部是蓝色「确定」。
    // 用 OCR 认「确定」两个字（配「白字掩码」做颜色二值化）——
    // 比写死坐标稳，而且各种「确定」弹窗都能一起收掉。
    "点掉挡路弹窗": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [150, 1100, 420, 180],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "max_hit": 20,
        "next": [
            "清障链"
        ]
    },
    // 「游戏停在**部落战页**」时的救回（2026-10-11 实测踩到，补的）。
    // ⚠️ 症状：上一轮部落战打完（或中途关掉）游戏就停在部落战那一页，此时再跑任何任务，
    //    清障链会一路失败 —— 因为那一页底部导航是「社交」选中态，
    //    **对战图标比 `nav/battle.png`（未选中态）小一圈**，`启动-回主界面` 认不出来
    //    （实测只有 0.34，阈值 0.6），于是磨光重试预算 → 环境未就绪 → 任务失败。
    // 判据/动作：认得到部落战页顶部那条「第 N 个对战日」（OCR 白字）就点**底部导航的「对战」**，
    //    实测点 (302,1215) 之后回到主界面（橙色锚点 count 13204）。
    //    固定坐标只用在「已经确认这是部落战页」之后的那一下，且目标落在固定版式的导航条里。
    "启动-从部落战页回主界面": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "对战日",
                "roi": [140, 18, 440, 64],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [302, 1215]
            }
        },
        "post_delay": 2500,
        "next": ["清障链"]
    },
    // 重试预算：60 次 × post_delay 2000 = 最多等 120 秒。
    // 用完 max_hit 之后，其他节点的 next 里它会被跳过 -> 清障链 只剩锚点可试
    // -> 超时 -> on_error -> 环境未就绪。这就是「多久没到主界面就报失败」。
    "再等等": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "post_delay": 2000,
        "max_hit": 60,
        "next": [
            "清障链"
        ]
    },
    // 主界面锚点 = 「对战」按钮那片橙色（色域沿用旧配置里实测过的 H_ORANGE）。
    // 默认 next 为空 = 准备完就结束（给「启动游戏」用）；
    // 「自动战斗」靠任务级 override 把它接进对战循环。
    "主界面锚点": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    244,
                    934,
                    250,
                    64
                ],
                "method": 40,
                "lower": [
                    5,
                    90,
                    140
                ],
                "upper": [
                    35,
                    255,
                    255
                ],
                "count": 8000
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        }
    },
    "环境未就绪": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "focus": {
            "Node.Action.Starting": {
                "content": "**没能进到游戏主界面**（等满重试预算还是没到）—— 本任务判失败。\n\n先看模拟器：游戏是不是没启动 / 卡在加载 / 掉登录态了？",
                "display": [
                    "log",
                    "notification"
                ]
            }
        },
        "timeout": 1000,
        "next": [
            "判失败"
        ]
    },

    // ——— 对战主循环 ———
    // 顺序 = 判定优先级。宝箱放最前：它在结算之后必现，且不影响计数。
    // ⚠️ 「[JumpBack]关掉卡牌已收到弹窗」排最前（2026-09-24 补，战斗稳定性关键）：
    //    这个弹窗是**在主界面上弹的**（收到卡牌时），而对战循环绝大多数时间就在主界面附近转；
    //    不处理的话，遮罩一压暗，「主界面」的橙色锚点 count 直接归零、
    //    「未知-点导航」的 nav/battle 掉到 0.44 —— 循环会一路落到「未知界面处理」，
    //    乱点 60 次（未知-点弹层）再重启 2 次游戏，整轮废掉。
    "对战循环入口": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "timeout": 20000,
        "on_error": [
            "打够了"
        ],
        "next": [
            "[JumpBack]关掉卡牌已收到弹窗",
            "奖励宝箱",
            "结算界面",
            "登录页",
            "对战中",
            "卡组页",
            "主界面",
            "匹配中",
            "未知界面处理"
        ]
    },
    // ★「打几局」：借「主界面」当计数器 —— 每开一局要点一次「对战」。
    // max_hit 由界面上的「每轮打几局」用 pipeline_override 注入。
    // ⚠️ 这个额度是「**一次任务运行内**」的，用完不重置 —— 所以「每轮打几局 × 跑几轮」
    //    在纯 JSON 里乘不出来。轮数交给 MFAAvalonia 的重复次数控件（见 interface.json
    //    的「日常循环」任务），每重复一次 = 新的一次任务运行，这个额度就归零了。
    // 打够之后 主界面 会被 next 跳过 -> 循环里没人命中 -> 超时 -> on_error -> 打够了。
    // ⚠️ 近似：中途若回到主界面会多计一次。协议里没有跨节点累加器，
    //    纯 JSON 想计数只能靠 max_hit 这种「用一次少一次」的机制。
    //    ⚠️ 这个节点定义在 main.json，别的文件**不要再定义同名节点**（重复定义行为不确定）。
    "主界面": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [
                    244,
                    934,
                    250,
                    64
                ],
                "method": 40,
                "lower": [
                    5,
                    90,
                    140
                ],
                "upper": [
                    35,
                    255,
                    255
                ],
                "count": 8000
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    369,
                    966
                ]
            }
        },
        "max_hit": 1,
        "post_delay": 2500,
        "next": [
            "对战循环入口"
        ],
        "on_error": [
            "对战循环入口"
        ]
    },
    "打够了": {
        "recognition": {
            "type": "DirectHit",
            "param": {}
        },
        "action": {
            "type": "StopTask",
            "param": {}
        },
        "focus": "打满设定的局数，收工"
    },
    // ══════════ 登录页守卫（2026-10-11 大改，原来只是个 StopTask）══════════
    //
    // 旧写法 `action: StopTask` 有两个问题，合起来正好造成
    // 「检测到未登录 → 只跳过这一步、后面接着跑」：
    //   ① MaaFramework 里「停止」= **成功**（见 base.json「判失败」那段源码说明）；
    //   ② MFAAvalonia 只认「任务失败」才会考虑中断队列，所以「成功」必然往后跑。
    //
    // 现在改成三件事：
    //   · **发通知**：`focus` 走 PI v2 的 `display` 渠道 —— `notification` 会在界面里
    //     弹一个提示框，`log` 同时写进运行日志。（实测该字段在你的 MaaFramework 版本里
    //     会随 `Node.Action.Starting` 一起回调，日志里能看到 `focus="检测到登录页…"`。）
    //   · **判失败**：`next` 指向「判失败」（一个 `enabled: false` 的节点）⇒ 任务状态 Failed。
    //   · **后续不做**：本节点已经挂在**所有任务入口的第一位**（见文件上方那段），
    //     所以后面每个任务一进来就被它拦住、同样判失败，不会再瞎点。
    //     ⇢ 如果你连「被拦住」都不要（想让客户端**直接停掉整条队列**），
    //       再去 MFAAvalonia 的「设置 → 游戏设置」把
    //       **「任务运行失败后是否继续运行其它任务」关掉** 即可。
    //
    // 判据安全性见文件上方「未登录守卫」那段的实测数据（正 1.0000 / 负 0.3238）。
    // ⚠️ `timeout: 1000` 是给「判失败」那条路兜底的：万一某个版本不认 `enabled: false`
    //    的短路，它会退化成「next 未命中等超时」，1 秒而不是默认 20 秒。
    "登录页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                // 两个特征**互为兜底**（数组 = 取分数最高的那个，天然是 Or）：
                //   cadpa.png        —— 左侧那个「12+」适龄提示徽章
                //   login_button.png —— 「微信登录」按钮（2026-10-11 从原生 720x1280 登录帧直裁）
                // 单特征风险太大（游戏换个徽章样式守卫就哑了），两个都验过：
                //   cadpa        正 1.0000 / 318 帧负样本最高 0.3238
                //   login_button 正 1.0000 / 317 帧负样本最高 0.4312
                // 阈值 0.8 落在宽空档里。回归工具：tools/verify_login_guard.py
                "template": [
                    "anchors/cadpa.png",
                    "anchors/login_button.png"
                ],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "DoNothing",
            "param": {}
        },
        "focus": {
            "Node.Action.Starting": {
                "content": "**检测到未登录界面**（微信 / QQ 登录页）—— 本任务判为失败，后面的任务也不会继续。\n\n请在模拟器里**手动登录**，然后重新开始任务。",
                "display": [
                    "log",
                    "notification"
                ]
            }
        },
        "timeout": 1000,
        "next": [
            "判失败"
        ]
    },

    // ══════════ 日常循环 / 退出游戏 ══════════
    // 一轮 = 自动战斗（打 N 局）+ 部落捐赠（捐 1 次）。
    // 「跑几轮」**不在流水线里数** —— 交给 MFAAvalonia 的重复次数控件
    // （扩展字段 `repeatable` / `repeat_count`，见 interface.json 的「日常循环」任务）。
    // 为什么不在流水线里数：`max_hit` 是「一次任务运行内的额度」，用完即废、**不会重置**，
    //    所以「每轮打几局 × 跑几轮」在纯 JSON 里乘不出来 —— 填 3 局 × 3 轮会变成
    //    第一轮连打 9 局，后两轮的战斗因为额度用尽被直接跳过。
    //    而客户端每重复一次都是**新的一次任务运行**，额度自然归零，
    //    「每轮打几局」才是真的「每轮」。
    // ⚠️ 代价：`repeatable` 是 MFAAvalonia 的扩展字段，MaaPiCli 与其他客户端不认，
    //    在 CLI 里只能验证**单轮**逻辑（战斗 → 捐赠）是否正确。
    // 一轮的接线由「日常循环」任务用 pipeline_override 注入（见 interface.json）：
    //    主界面锚点 -> 对战循环入口（先打）
    //    打够了     -> 部落进入聊天（打完去捐）
    //    收尾回主界面（daily.json，next 为空）-> 本轮结束
    "循环任务入口": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["登录页", "环境准备"]
    },
    // 退出游戏：独立任务，跑到就直接关掉游戏，没有任何前置动作（不重新拉起游戏）。
    // 原「日常一条龙」的收工节点就是它 —— 那条融合链已按用户要求拆成独立任务。
    //
    // ⚠️ 2026-10-11 拆成两个节点，**就为了插一道登录页守卫**：
    //    停在登录页时还去关游戏是最讨厌的 —— 用户正要去模拟器里手动登录，游戏却被关了。
    //    所以先看「登录页」（是 → 判失败，游戏留着不动），不是才去关。
    "退出任务": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["登录页", "退出-关游戏"]
    },
    "退出-关游戏": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "StopApp",
            "param": {
                "package": "com.tencent.tmgp.supercell.clashroyale"
            }
        },
        "post_delay": 2000,
        "next": [],
        "focus": "已关闭游戏"
    }
}
