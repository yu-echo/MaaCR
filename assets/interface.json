{
    // 本文件是 ProjectInterface V2 协议描述，告诉通用 UI（MFAAvalonia 等）
    // 这个项目要用哪些资源、有哪些任务可跑、各任务可以调什么参数。
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    //
    // 说明：本项目目前只做简体中文，所以界面文案直接写中文。
    // 以后要多语言：把要翻译的文案前面加 $ 前缀，再加 languages 字段指向
    // 翻译文件（扁平 key-value JSON）即可。
    "interface_version": 2,
    "name": "MaaCR",
    "title": "MaaCR · 皇室战争国服助手",
    "version": "0.1.0",
    "license": "MIT",
    "github": "https://github.com/yu-echo/MaaCR",
    "description": "皇室战争国服（腾讯代理版）自动化助手：自动对战刷局，其余日常任务在移植中。\n\n基于 MaaFramework，界面由 MFAAvalonia 提供。\n\n⚠️ 目标是**快速刷完尽可能多的对局**（刷宝箱 / 对局时长 / 卡牌大师进度），**不是上分**。评估它好不好用请看**每局对战耗时**，不是胜率。",
    "welcome": "首次使用前请先看 README 的「使用前准备」一节：需要 MuMu 模拟器、里面装好国服皇室战争、并且已经手动登录过一次（微信 / QQ 授权本工具不碰）。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            // 截图会缩放到「短边 720」。国服皇室战争是 720x1280 竖屏，
            // 缩放比正好 1:1 —— 所以 image/ 里的模板与 pipeline 里的坐标
            // 都是按 720x1280 量的，改这里就必须重采模板 + 重标坐标。
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        // 路径相对 **interface.json 所在目录**（也就是 assets/）解析，所以是 ../
        // -u 强制无缓冲输出：不然长任务跑起来日志会长时间不刷新，看起来像卡死。
        "child_exec": "python",
        "child_args": [
            "../agent/main.py",
            "-u"
        ]
    },
    "pretask": {
        // 控制器建立**之前**执行：① 确认目标是本地模拟器而不是插着的真机；
        // ② 模拟器没在跑就自己拉起来。非零退出会中止启动，正好当闸门用。
        //
        // ⚠️ 这两行的写法是两个坑逼出来的，别顺手「简化」回去：
        //
        // 1) exec **不走 PATH 查找**。MFAAvalonia 把它当成「<数据目录>/resource/base」
        //    下的相对路径，直接 Path.Combine 拼接（v2.16.1 源码 MaaProcessor.cs：
        //    ReplacePlaceholder(preTask.Exec, ResourceBase)，而 ResourceBase =
        //    DataRoot/resource/base）。所以哪怕写成 "python"，拼出来的也是
        //    「…/resource/base/python」这样一个不存在的文件，启动即失败 ——
        //    官方文档说「可以直接写 python」，跟实现对不上。
        //    → 绕法：拿绝对路径的 cmd.exe 当壳，真正要跑的命令交给它，由 cmd 去 PATH 里找。
        //
        // 2) args 跟 exec **不是一个基准**：args 是按「工作目录」解析的，
        //    而工作目录同样是 resource/base。所以要从 assets/resource/base
        //    往上三层才回到仓库根。
        //
        // 另外 assets/resource/base/ 这个空目录本身也必须存在（见那里的 .gitkeep）：
        // 工作目录不存在的话，Process.Start 一样会报「目录名无效」。
        //
        // 发布包里这两行由 tools/install.py 改写成指向自带 Python 的版本。
        "name": "环境准备",
        "label": "环境准备（检查设备 + 启动模拟器）",
        "exec": "C:/Windows/System32/cmd.exe",
        "args": [
            "/c",
            "python",
            "../../../tools/preflight.py"
        ]
    },
    "group": [
        {
            "name": "battle",
            "label": "对战任务",
            "default_expand": true
        },
        {
            "name": "daily",
            "label": "日常任务",
            "default_expand": true
        }
    ],
    "task": [
        {
            "name": "自动对战",
            "entry": "启动检查",
            "group": [
                "battle"
            ],
            "default_check": true,
            "description": "自动把游戏调到前台 -> 进局 -> 按策略下牌 -> 结算 -> 再进局，直到打满指定局数。\n\n认不出来的界面有三级自愈：先试着点底部导航回主界面，再当全屏弹层推进，最后判定「认不出 + 画面定格」就重启游戏。",
            "option": [
                "打几局",
                "出牌门槛",
                "演练模式"
            ]
        },
        {
            "name": "领商店免费项",
            "entry": "商店任务",
            "group": [
                "daily"
            ],
            "description": "进商店，把「每日精选」里价格写着「免费」的卡都领掉。\n\n判据是那两个**字**（白字掩码匹配），不是颜色 —— 免费项不一定是绿卡。看到「已收集！」就停：它是「今天已领完」的信号，继续翻下去只是空转（列表实测有 37~55 屏）。\n\n⚠️ 只能领免费的。弹窗里那个绿色「免费！」按钮是**先认出才点**的，不会盲点坐标误领要花宝石的卡。",
            "option": [
                "演练模式"
            ]
        },
        {
            "name": "部落捐赠",
            "entry": "部落任务",
            "group": [
                "daily"
            ],
            "description": "进部落聊天，把能捐的卡牌请求捐掉。\n\n只看**亮绿色**的「捐赠」按钮（底色饱和度高＝可捐）；灰的是自己发起的请求，捐不了。点一下就直接捐出，没有二次确认弹窗。底部的「确定」只在全部捐完之后点一次 —— 那是退出聊天的按钮，每捐一次点它一下就直接退出了。",
            "option": [
                "捐几次",
                "演练模式"
            ]
        }
    ],
    "option": {
        "打几局": {
            "type": "input",
            "label": "最多打几局",
            "description": "打满这个局数就停下。默认 1 局 —— 第一次跑建议就用 1。",
            "inputs": [
                {
                    "name": "局数",
                    "label": "局数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "对局数已达标": {
                    "custom_recognition_param": {
                        "matches": "{局数}"
                    }
                }
            }
        },
        "出牌门槛": {
            "type": "input",
            "label": "出牌圣水门槛",
            "description": "圣水到这个数才出牌。调低（5~6）= 出牌更勤、更像无脑速推；调高（9~10）= 攒一波再推。\n\n原来的自动精灵脚本是「必须满 10 才出」，白白浪费回蓝，所以默认降到 8。",
            "inputs": [
                {
                    "name": "门槛",
                    "label": "门槛",
                    "default": "8",
                    "pipeline_type": "int",
                    "verify": "^(10|[0-9])$",
                    "pattern_msg": "请填 0~10 的整数"
                }
            ],
            "pipeline_override": {
                "对战中": {
                    "custom_action_param": {
                        "min_elixir": "{门槛}"
                    }
                }
            }
        },
        "捐几次": {
            "type": "input",
            "label": "部落最多捐几次",
            "description": "一次进部落最多捐几次。默认 4。\n\n当前屏没有可捐的请求时会自动往上翻聊天记录找，最多翻 8 层。",
            "inputs": [
                {
                    "name": "次数",
                    "label": "次数",
                    "default": "4",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "部落捐赠": {
                    "custom_action_param": {
                        "donate_rounds": "{次数}"
                    }
                }
            }
        },
        "演练模式": {
            "type": "switch",
            "label": "演练模式（只识别不点击）",
            "description": "只截图 + 识别 + 打印决策，一次都不点。用来验证「它认不认得准」。\n\n对**所有任务**生效：对战、商店、部落都是。",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "对战中": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "结算界面": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "宝箱弹层": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "卡组页": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "未知界面处理": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "主界面": {
                            "action": "DoNothing"
                        },
                        "商店领免费项": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        },
                        "部落捐赠": {
                            "custom_action_param": {
                                "dry_run": true
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    },
    "setting": [
        {
            "name": "battle_setting",
            "label": "全局设置",
            "description": "对所有任务生效。",
            "option": [
                "出牌门槛",
                "演练模式"
            ]
        }
    ],
    "preset": [
        {
            "name": "刷 5 局",
            "description": "打满 5 局就停。",
            "task": [
                {
                    "name": "自动对战",
                    "enabled": true,
                    "option": {
                        "打几局": {
                            "局数": "5"
                        }
                    }
                }
            ]
        },
        {
            "name": "只认不打（演练）",
            "description": "打 1 局但一次都不点击，用来检查识别准不准。",
            "task": [
                {
                    "name": "自动对战",
                    "enabled": true,
                    "option": {
                        "演练模式": "Yes"
                    }
                }
            ]
        },
        {
            "name": "日常一条龙",
            "description": "领商店免费项 + 部落捐赠，各跑一遍，跑完自动回主界面。",
            "task": [
                {
                    "name": "领商店免费项",
                    "enabled": true
                },
                {
                    "name": "部落捐赠",
                    "enabled": true
                }
            ]
        }
    ]
}
