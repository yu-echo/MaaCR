        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "牌",
                        "recognition": "TemplateMatch",
                        "template": "cards/气球兵.png",
                        "roi": [108, 1011, 712, 1267],
                        "threshold": 0.85
                    },
                    {
                        // 圣水条第 5 费位置（洋红，与「出牌-圣水够」同一套判据）
                        "recognition": "ColorMatch",
                        "roi": [419, 1230, 6, 40],
                        "method": 40,
                        "lower": [138, 70, 170],
                        "upper": [175, 255, 255],
                        "count": 50
                    }
                ],
                "box_index": 0
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "pre_delay": 100,
        "post_delay": 350,
        "next": ["落点"],
        "on_error": ["对战等待"]
    },
    "出-武士": {
        // ★ 门槛：**圣水 ≥ 这张牌自己的费用（5 费）**才出。
        //   配合 next 按费用从高到低 = 「先出能出的最大牌、余费再补低费」。
        "recognition": {
