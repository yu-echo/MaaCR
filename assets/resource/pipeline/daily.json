{
    // ★ 日常任务：纯 JSON 版。
    //
    // ══ 2026-09-24 实机重写：商店路径 + 滑动节奏 ══
    //
    // 真实路径（用户截图 1..5 指的「顺序」+ 本机逐步实测确认）：
    //   底部「商店」→ 左上「礼物盒」分类图标（把页面复位到超值推荐顶部）
    //   →「超值推荐」页签 → **慢速下翻 20 屏以上** →「每日精选」区
    //   → 点第一格的浅绿「免费！」卡 → 弹窗「获取宝石？」→ 点绿色「免费！」按钮
    //   → 卡片立刻变「已收集！」，弹窗自动关闭。
    //
    // 实测记录（MuMu 720x1280，2026-09-24 00:0x）：
    //   · 免费卡在「每日精选」**第一格**；点文字处即打开弹窗（实测点 (118,408) 命中）。
    //   · 弹窗确认键是**绿色「免费！」**（不是「领取」）；弹窗标题「获取宝石？」。
    //   · 领完宝石 8497 -> 8522（+25），**没有**「恭喜获得」二次弹窗要点。
    //   · 超值推荐页极长：连翻 30 屏仍是付费项/宝箱板块 —— 必须给足滑动预算。
    //   · 底部导航角标实测在 y 1155~1185，导航条起点约 y 1110（roi 用 1110 起）。
    //
    // ══ 用户明确反馈：滑动太快 OCR 认不出来 ══
    // 三层一起改：① duration 1200ms（慢拖，不是快甩，几乎不产生惯性）；
    //            ② `end_hold: 300` —— 到终点**先按住停 300ms 再抬手**，彻底消掉惯性滚动；
    //            ③ post_delay 1800 —— 等画面完全静止再让识别读，避免读到模糊帧。
    //
    // ══ 「翻到底就跳过」怎么落地 ══
    // 用 max_hit 当滑动预算。实测确认（maxhit 探针）——**max_hit 用尽的节点，
    // 在调用方的 `next` 和 `on_error` 两个列表里都会被跳过**。所以把终点节点排在
    // 预算节点后面即可：预算用完 -> 被跳过 -> 自动落到「商店扫到底」收工，不报错。
    // ⚠️ 纯 JSON 判不出「列表真的到底了」（没有帧间差能力），只能用**次数**近似。
    //    max_hit 20 × 每屏下移约 720px ≈ 覆盖 18 屏内容，比实测的「16 屏到底」留 4 屏余量。
    // ★ 「连着几屏没东西就收工」**不用另想办法** —— 它就是 max_hit：
    //    有东西 -> 走 next 停下领取；没东西 -> 继续滑。所以「连着 N 屏没东西」
    //    与「最多滑 N 次」是同一件事，max_hit 本身就是那个计数器。
    //    这个值已接到界面选项「商店最多翻几屏」（默认 60），不用改文件就能调。
    // ★★ 2026-09-25 用户要求「翻到每日精选就该判断，没有免费就结束」——
    //    **正常路径现在根本不靠 max_hit 收工**：`商店扫屏` 的 next 末尾挂了
    //    `商店到每日精选`，翻到那一屏（免费项的固定位置）还没得领就直接收工。
    //    实测：只滑 17~23 屏、整段 1 分 40 秒 ~ 2 分 14 秒（原来翻满 60 屏要 5~6 分钟）。
    //    max_hit 因此降级成**兜底**：只有「每日精选」一直认不出来时才用得上。

    // 只做颜色二值化的辅助节点：游戏 UI 文字都是「白字 + 深色描边」，
    // 所以按「够白」筛一遍，就把底色/卡面整个忽略掉了。
    // ⚠️ 阈值要严（V≥225 且 S≤40）：宽松一点会把浅灰底整张卡算成白，掩码变实心块。
    //    实测「每日精选」免费卡的浅绿底 S≈43~58%，正好被 S≤40 挡在外面，白字能干净留下。
    // 它自己不参与流程，只被 OCR 的 color_filter 引用（协议：只取 method/lower/upper）。
    "白字掩码": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [0, 0, 1, 1],
                "method": 40,
                "lower": [0, 0, 225],
                "upper": [180, 40, 255],
                "count": 1
            }
        },
        "action": {"type": "DoNothing", "param": {}}
    },

    // ——— 商店 ———
    // 入口只挂「环境准备」：它是 DirectHit、永远命中，会走完整条启动链。
    // 启动链之后去哪儿由 interface.json 的任务级 override 注入（-> 商店去商店页）。
    "商店任务": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["环境准备"]
    },
    // ① 进商店页：点底部导航的「商店」。
    // ⚠️ 模板是**未选中**态（nav/shop.png）。已经在这一页时底部显示的是选中态
    //    （icon 变亮/放大），这个节点就匹配不上 —— 正好，不会重复点。
    //    匹配不上也没关系：on_error 直接接到下一步，路径不断。
    // ⚠️ roi [0,1140,720,140] 是**上一轮真机已跑通**的取值，故意不动。
    "商店去商店页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/shop.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["商店进礼物盒"],
        "on_error": ["商店进礼物盒"]
    },
    // ② 点左上「礼物盒」分类图标 —— 用户截图第 2 张。
    // 它的作用不是「领礼物」，而是**把商店页复位到「超值推荐」的顶部**：
    // 实测点一下之后页面回到顶部（创作者代码横幅那一屏），这样下面「翻 20+ 屏找每日精选」
    // 才是从确定的位置出发的。已经在礼物分类时再点一次是幂等的。
    // ⚠️ 模板只裁了**盒身**（不含单元格底色）：礼物盒被选中时单元格底是浅蓝、
    //    未选中时是深蓝，连带底色一起裁会在另一种状态下匹配不上。
    "商店进礼物盒": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/gift_icon.png",
                "roi": [0, 80, 720, 170],
                "threshold": 0.8
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 3000,
        "next": ["商店选超值推荐"],
        "on_error": ["商店选超值推荐"]
    },
    // ③ 确保停在「超值推荐」页签 —— 用户截图第 3 张。
    // 页签行是**固定表头**（不随列表滚动），所以这一步任何滚动位置都能命中。
    // 已经是选中态时再点一次是幂等的。
    "商店选超值推荐": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "超值推荐",
                "roi": [0, 170, 720, 150],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["商店扫屏"],
        "on_error": ["商店扫屏"]
    },
    // ④ 扫屏：短超时看这一屏有没有可领的（免费 / 维护）。
    // ⚠️ 写法要点：被念到的节点若识别不到，会**在 next 列表里循环重试直到 timeout**，
    //    所以才要把「扫屏」做成短超时的哨兵、把「滑动」放在 on_error 里 ——
    //    反过来的话每屏要空等 20 秒才滑。
    // ⚠️ on_error 顺序 = 「滑动 -> 收工」：滑动是 DirectHit 一定命中，收工只在预算用尽后轮到。
    "商店扫屏": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1500,
        // ⚠️ 顺序即优先级：先领**补偿礼包**（维护/异常补偿那种整屏卡片 + 深色「免费！」按钮），
        //    再领「每日精选」左列第一格的每日免费礼物；
        //    两个都没有、而且**已经翻到「每日精选」**时，就说明今天这块没得领了 ——
        //    直接收工，不再往下翻几十屏。
        "next": ["商店领维护礼", "商店领免费项", "商店到每日精选"],
        "on_error": ["商店滑一屏", "商店扫到底"]
    },
    // 领「每日免费礼物」：用**原色模板**认「免费！」那两个字。
    // 为什么不用 OCR：这两个字是「白字 + 深色描边」，压在浅绿卡面上，
    // 白字掩码的 S≤40 与卡面绿的 S≈43% 只差一点点，靠得太近；
    // 而模板是直接从真机卡面裁的（底色 (97,237,152) 与实测卡面 (93,221,140) 一致），
    // 颜色/字号完全对得上，更稳。
    // ⚠️ roi 只框**左列**：免费卡固定是「每日精选」第一格（左列），
    //    这样不会去匹配列表里其他地方同样写着「免费」的小字。
    // ⚠️ target_offset 往上挪 150px：文字写在卡片**底部**，直接点文字有概率点到
    //    卡片下沿或网格缝隙（旧版「点了没反应」就是这么来的）；-150 仍落在卡身内。
    // ⚠️ timeout 给 8 秒：这是**点完之后等弹窗**的预算，比「扫屏」长得多。
    "商店领免费项": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/free_label.png",
                // y 下沿放宽到 1140（原来 1040）：理由见下面「商店到每日精选」那段。
                // x 仍然只框**左列**（免费项固定是每日精选第一格），
                // 这样不会去匹配列表里其它地方同样写着「免费」的小字。
                "roi": [0, 200, 260, 940],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true,
                "target_offset": [0, -150, 0, 0]
            }
        },
        "timeout": 8000,
        "next": ["商店确认免费"],
        "on_error": ["商店扫屏"]
    },
    // 领「维护补偿 / 异常补偿」：这两类是官方维护后挂在「超值推荐」列表里的**免费补偿礼包**。
    // 2026-09-30 实机标定重写 —— 旧版是「OCR 认『维护』两个字 + 点文字」，实测有两个硬伤：
    //   ① 名字里**不一定带「维护」**：本次实测第一个礼包叫「炽焰战甲异常补偿」，
    //      OCR 永远认不到它；
    //   ② 点的是**横幅标题文字**，那不是领取入口 —— 真正的入口是卡片底部那条
    //      **深色（近黑）横条 + 白字「免费！」**。
    // 现在直接认那条按钮：模板 `shop/free_label_dark.png` 就是 2026-09-30 从真机裁的原色图。
    // ⚠️ 分离度实测（TM_CCOEFF_NORMED）：
    //    正样本 = 两个补偿礼包的按钮，0.9964 ～ 0.9970；
    //    负样本最高 = 0.6382（「每日精选」第一格那张**浅绿底**的「免费！」卡 —— 底色不同，天然分开），
    //    整页 16 屏扫描的其它位置全部 ≤ 0.4033。阈值 0.85 落在空档正中。
    // ⚠️ roi 覆盖**整个列表可视区**（y 266～1130，避开固定的页签表头与底部导航栏）：
    //    按钮会随滚动停在屏幕任何高度，所以不能像「商店领免费项」那样锁死左列；
    //    但也不能框进顶部栏 / 导航栏 —— 那是固定 UI。
    // ⚠️ 两个礼包都是**宝箱**。「每日精选」的宝箱免费项实测是**点开即开箱、无二次确认弹窗**，
    //    但补偿礼包不是 —— 见下面 2026-09-30 的实跑结论。
    // ✅ 2026-09-30 实机验证通过（MaaPiCli `-d`，日志 `env/maapicli/run_freegift1.log`）：
    //    两款礼包（「炽焰战甲异常补偿」「维护补偿！」）各命中一次 —— 模板得分 0.9972 / 0.9964；
    //    点击「免费！」后弹出的是**「确认购买？您要购买该特惠活动礼包吗？」**弹窗（不是直接开箱），
    //    弹窗里的绿色「免费！」确认键由 `商店确认免费` 认到并点掉（`shop/free_confirm.png` 得分 0.9850）。
    //    领取结果：前者给**觉醒币 x30**（库存 18 → 48），后者进**紫箱开箱动画**。
    //    任务以 `### All tasks have been completed ###` 收尾，全程无 ERR。
    "商店领维护礼": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/free_label_dark.png",
                "roi": [0, 266, 720, 864],
                "threshold": 0.85
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "timeout": 8000,
        "next": ["商店开箱界面", "商店确认免费", "商店扫屏"],
        "on_error": ["商店扫屏"]
    },
    // 收工判据：翻到「每日精选」了 —— 免费项就固定在这块的第一格。
    // 它排在「领免费项 / 领维护礼」**后面**，所以同一屏里真能领的会先被领掉；
    // 轮到它命中，就说明这一屏再没有能领的了 —— **收工，不再往下翻**。
    // （2026-09-24 用户要求：别为了找免费项白翻几十屏。）
    // ⚠️ 2026-09-30 更正：原先担心的「挂在每日精选更下面的『维护补偿』会扫不到」
    //    **实测不成立** —— 补偿礼包挂在列表**中段**，位置在「每日精选」**上方**约 4000px
    //    （从每日精选往上翻 15 屏才到维护补偿）。顺扫一定先遇到补偿礼包，不会漏。
    // ⚠️ roi 取 [0,80,720,820]（高 740）是**故意的**：滑动步长 720px，
    //    判定区间必须比步长宽，否则标题可能正好从两次滑动之间「跳过去」，永远不命中。
    // ⚠️ 配套把「商店领免费项」的 roi 下沿放宽到 1140：标题落在判定区间最下沿时，
    //    免费项那一格还在屏幕上（约 y 1100），不能因为 roi 太窄而漏认。
    "商店到每日精选": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "每日精选",
                "roi": [0, 80, 720, 820],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "next": ["商店扫到底"]
    },
    // 弹窗里的绿色「免费！」确认键 —— 这个必须用**原色模板**。
    // 为什么不能盲点固定坐标：弹窗内容随当日免费项变（宝石/宝箱/卡牌），
    // 点错会按到隔壁那张要花宝石的卡上。「先认出再点」是硬要求。
    // 点完（无论出没出弹窗）都回「商店扫屏」，不在这里判断成败。
    "商店确认免费": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/free_confirm.png",
                "roi": [0, 520, 720, 560],
                "threshold": 0.85
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        // ⚠️ 2026-09-30：原来没写 timeout（= 默认 20 秒）。现在「商店领维护礼」的 next 里也念它 ——
        //    它命中的时机是「补偿礼包点击后弹出确认弹窗」，实测 1 秒内就出来；
        //    不压低这个值的话，碰到没有弹窗的路径（比如直接开箱）就要白等 20 秒才轮到下一个候选。
        "timeout": 5000,
        "next": ["商店扫屏"],
        // ⚠️ 2026-09-28 加「商店开箱界面」：免费项是**宝箱**时**没有二次确认弹窗**，
        //    点「免费！」直接就把箱子开了，于是这个节点认不到绿色确认键 → 走 on_error。
        //    那一刻屏幕已经是开箱结果界面，必须先把它逐屏点掉再回扫屏 ——
        //    否则「商店扫屏」的三个识别全落空，只会在那一屏上空滑
        //    （2026-09-28 实测：空转了 960 次翻页、任务卡死不动）。
        "on_error": ["商店开箱界面", "商店扫屏"]
    },
    // 商店免费项是**宝箱**时，点开后会停在这个「开箱结果」界面上**逐条**展示奖励：
    //    左上一张奖励卡 + 右侧文字，屏幕中部一只宝箱，右上角红方块里是剩余宝箱数
    //    （实测 3→2→1→0）。**点一下推进一项**，全部展示完再点一下才回商店。
    // ⚠️ 判据为什么不用宝箱模板：宝箱在这段里有开盖 + 光效动画，**同一界面不同帧**
    //    的匹配分从 1.0000 掉到 0.4881，而商店列表页（负样本）最高 0.6759 ——
    //    两个区间**重叠**，任何阈值都分不开，所以宝箱图不能当判据。
    //    改认右侧那行**文字**：它随稀有度变色（资源卡青 / 普通卡浅蓝 / 史诗卡紫粉），
    //    所以**绝不能加 color_filter**，用原色 OCR（PaddleOCR 对彩色字一样认）。
    // ⚠️ 动作点 (360,1000)：实测该点在开箱界面是**全空背景**（不会误触任何按钮），
    //    点下去正好推进一项；连点 6 次走完 3 个宝箱并自动回到商店，全程无副作用。
    // ⚠️ max_hit 12 = 最多点 12 次；用完后自己就不能再被调用 → next 耗尽
    //    → on_error 回「商店扫屏」，不会死循环。
    // ⚠️ next 指向自己是**故意的**：每点一次都要重新识别一次（那时可能已经回到商店了），
    //    识别不到就自然停下，比无脑连点安全。
    "商店开箱界面": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
