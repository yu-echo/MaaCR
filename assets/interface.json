{
    // 本文件是 ProjectInterface V2 协议描述，告诉通用 UI（MFAAvalonia 等）
    // 这个项目要用哪些资源、有哪些任务可跑、各任务可以调什么参数。
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    //
    // 说明：本项目目前只做简体中文，所以界面文案直接写中文。
    // 以后要多语言：把要翻译的文案前面加 $ 前缀，再加 languages 字段指向
    // 翻译文件（扁平 key-value JSON）即可。
    "interface_version": 2,
    "name": "MaaCR",
    "title": "MaaCR · 皇室战争国服助手",
    // 界面里显示的图标。MFAAvalonia 的 IconHelper 只认这个字段（按数据目录解析），
    // 没写就会退回它自己内嵌的 logo.ico —— 这就是「换了 logo 但界面里没变」的原因。
    //
    // 特意用**深底**那张：浅色插画在 24px 的标题栏里会糊成一团白，深底才看得清。
    // 文件放在 assets/icon.png，手工组装发布包时要把它放到包根 ——
    // 开发时数据目录是 assets/、发布时是包根，相对路径 "icon.png" 两种布局都对得上。
    "icon": "icon.png",
    "version": "0.1.0",
    "license": "MIT",
    "github": "https://github.com/yu-echo/MaaCR",
    "description": "皇室战争国服（腾讯代理版）自动化助手：自动对战刷局与日常任务。\n\n⚠️ 目标是**快速刷完尽可能多的对局**（刷宝箱 / 对局时长 / 卡牌大师进度），**不是上分**。",
    // 公告框左边那一栏很窄：文案一长就会被挤成一列一个字，所以这里只写一句话。
    "welcome": "第一次用之前请先看 README 的「使用前准备」。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            // 截图会缩放到「短边 720」。国服皇室战争是 720x1280 竖屏，
            // 缩放比正好 1:1 —— 所以 image/ 里的模板与 pipeline 里的坐标
            // 都是按 720x1280 量的，改这里就必须重采模板 + 重标坐标。
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ⚠️ 这里**故意不设顶层 group、task 里也不写 group**。
    // group 是 PI v2.4.0 才加的字段，「通用 UI」版本低一点就可能认不出来 ——
    // 实测踩过：任务列表里一个任务都不显示，只剩「全局设置」，看着像任务没了。
    // 参考实现 MaaYuan 也是平铺列的（它的界面正常），所以就照这个来。
    "task": [
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "default_check": true,
            "description": "先把游戏准备妥当，再跑别的任务：点亮屏幕、把游戏切到最前面、等画面出来。\n\n⚠️ **掉登录态会直接判失败**：如果发现游戏停在微信 / QQ 登录页，会提示任务失败，后面勾选的任务也不会再跑。在模拟器里手动登录一下，再重新点「开始任务」即可。",
            "option": [
                "游戏版本"
            ]
        },
        {
            "name": "领商店礼包",
            "entry": "商店任务",
            "default_check": true,
            // ⚠️ 这个 override 是**必须的**，不是可有可无的润色。
            // 「环境准备」是 DirectHit，永远命中 —— 所以任何任务都会先走完整条启动链，
            // 最后停在「主界面锚点」上。而主界面锚点的 next 默认是**空的**，
            // 协议里 next 为空 = 任务终止。也就是说：不接这一根线，
            // 这个任务会在到达主界面之后就结束，商店逻辑一次都跑不到。
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "商店去商店页"
                    ]
                }
            },
            "description": "打开商店，把能白拿的东西领掉：**维护 / 异常补偿礼包**和**每日免费礼物**。\n\n会一屏一屏慢慢往下翻，翻到底没有就跳过、收工回主界面；只领免费的，不会误点要花宝石的卡。",
            "option": [
                "领取内容",
                "商店翻几屏"
            ]
        },
        {
            "name": "部落捐赠",
            "entry": "部落任务",
            // 同上：不接这一根线，任务到主界面就结束了。
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "部落进入聊天"
                    ]
                }
            },
            "description": "进部落聊天，把能捐的卡捐出去（只点亮着的「捐赠」按钮）。\n\n当前这屏没有能捐的，会往上翻聊天记录找，最多翻 8 屏；翻到底还是没有就跳过、收工。\n\n⚠️ 游戏不允许「只捐一部分」：点一下就把请求还差的卡全捐出，所以「每次捐赠几张」的数字是折算的，不是精确张数。",
            "option": [
                "每次捐赠几张",
                "请求卡牌",
                "要请求的卡牌"
            ]
        },
        {
            "name": "部落战",
            "entry": "部落战任务",
            // 同上：不接这一根线，任务到主界面就结束了。
            "default_check": false,
            // ⚠️ 这几个 override 是**必须**的：battle.json 的出牌链路打完一张之后，
            //    出口默认是回「对战循环入口」（= 天梯循环）。部落战里必须把它们接回
            //    `部落战-战斗中`，否则一打起牌就串到天梯链上去了。
            //    「对战等待」还额外接管**认不出的牌**：随机卡组认不出任何已知卡时
            //    落这里 → `部落战-乱丢-选牌` 随便丢一张（2026-10-15 用户口径）；
            //    乱丢预算用光时靠第二个候选 `部落战-战斗中` 兜底，不会 next 耗尽。
            //    （只影响「部落战」这一个任务 —— 天梯那几个任务的 override 不变。）
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "部落战-进社交页"
                    ]
                },
                "落点-破塔深位": {
                    "next": [
                        "部落战-战斗中"
                    ]
                },
                "落点-桥头": {
                    "next": [
                        "部落战-战斗中"
                    ]
                },
                "落点-飞桶-大本营": {
                    "next": [
                        "部落战-战斗中"
                    ]
                },
                "落点-飞桶-一塔": {
                    "next": [
                        "部落战-战斗中"
                    ]
                },
                "对战等待": {
                    "next": [
                        "部落战-乱丢-选牌",
                        "部落战-战斗中"
                    ]
                }
            },
            "description": "自动打**部落战（河道竞速）**：进部落战 → 点地图上的「对战」→ 开打 → 打完回到地图再开下一局，**最多 4 局**（对战日每天 4 个卡组各一次）。\n\n· 搜不到对手（排队超过 1 分钟）会自动取消并跳过这个任务。\n· 战斗中认得出的牌正常出；认不出的牌随手丢一张（圣水不足时不丢）。\n\n⚠️ 乱丢不一定能赢，但对战日只要下场参战就算数。\n⚠️ 一局要好几分钟，4 局约 10 分钟以上，中途别去动模拟器。",
            "option": []
        },
        {
            "name": "自动战斗",
            "entry": "启动检查",
            // ⚠️ 默认**不勾**，且必须与预设里那条 "enabled": false 保持一致 ——
            // 包里预置了实例配置（绕开首次启动的时序缺陷），那种情况下**不走 ApplyPreset**，
            // 勾选状态就退回用这个 default_check 了。
            "default_check": false,
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "对战循环入口"
                    ]
                }
            },
            "description": "自动打对局：出牌 → 打完一局 → 再开下一局，一直打到设定的局数。\n\n认不出画面时它会自己想办法：先退主界面，还不行就重开游戏。\n\n⚠️ 目标是快速刷局（刷宝箱、对局时长、卡牌大师进度），**不是上分** —— 输是正常的，好不好用看每局耗时。",
            "option": [
                "打几局",
                "对战策略"
            ]
        },
        {
            "name": "日常循环",
            "entry": "循环任务入口",
            "default_check": true,
            // ★ 重复次数用 MFAAvalonia 的扩展字段 —— ProjectInterface V2 协议本身没有。
            // 官方 README：「MFAAvalonia 在 Project Interface V2 的 task 项中额外支持
            //   repeatable / repeat_count」，开了之后界面里会多一个重复次数控件，
            //   在界面改的值随实例配置保存。
            // 为什么必须借客户端：pipeline 的 `max_hit` 是「一次任务运行内的额度」，
            //   用完不重置，所以「每轮打几局 × 跑几轮」在纯 JSON 里乘不出来
            //   （填 3 局 × 3 轮会变成第一轮连打 9 局、后两轮跳过战斗）。
            //   客户端每重复一次 = **新的一次任务运行** -> 额度归零，「每轮」才是真的每轮。
            // ⚠️ MaaPiCli 与其他客户端不认这两个字段，在 CLI 里只能验证单轮逻辑。
            "repeatable": true,
            "repeat_count": 1,
            "description": "一轮 = **自动战斗（打几局）+ 部落捐赠（捐一次）**，跑完回主界面，下一轮自动接着开始。\n\n**「跑几轮」用这个任务的「重复次数」控件设置**（默认 1）。",
            "option": [
                "打几局",
                "对战策略",
                "每次捐赠几张",
                "请求卡牌",
                "要请求的卡牌"
            ],
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "对战循环入口"
                    ]
                },
                "打够了": {
                    "action": {
                        "type": "DoNothing",
                        "param": {}
                    },
                    "next": [
                        "部落进入聊天"
                    ]
                }
            }
        },
        {
            // ★ 2026-10-15 新增（用户要求）：「不看局数、只看宝箱打完没有」的版本。
            //   判据 = 主界面中间那根「四个宝箱都领完」的紧凑木条
            //   （anchors/chest_bar_done.png，验收数据见 chestloop.json 顶部）。
            //   每打完一局进部落检查一次捐赠；宝箱打完 -> 收工。
            "name": "日常循环（打完宝箱版）",
            "entry": "宝箱循环-任务入口",
            // 默认不勾，与预设里那条 enabled: false 保持一致。
            // 它与「日常循环」互斥（两者都在打对战刷局）——要用时把它勾上、
            // 把「日常循环」取消勾选。
            "default_check": false,
            "description": "一直打到**今日的四个宝箱全部拿完**才收工（不设局数）。\n\n· 主界面那根「四个宝箱都领完」的木条在 → 今日已打完，收工；\n· 不在 → 打一局 → 进部落检查一次捐赠 → 再看木条 → 接着打。\n\n⚠️ 有 40 局安全上限（防判据失效的内部保险，正常碰不到）。\n⚠️ 别和「日常循环」同时勾选（两者都在打对战）。\n⚠️ 一局约 2~4 分钟，打完四个宝箱通常 1~3 小时，挂上后中途别动模拟器。",
            "option": [
                "对战策略",
                "每次捐赠几张",
                "请求卡牌",
                "要请求的卡牌"
            ],
            // 接线总览（每个 override 为什么是必须的，见 chestloop.json 顶部）：
            //   主界面锚点 -> 决战检查（起点先判一次：已打完就直接收工）
            //   对战循环入口 -> 把「主界面（点对战开打）」换成
            //     [宝箱循环-已完成, 宝箱循环-开战]（先判木条，再点开打）
            //   点结算确定 -> 战后（等开箱动画/弹窗过去，再去捐赠）
            //   奖励宝箱.on_error -> 进捐赠（开箱动画结束不回国把捐赠漏掉）
            //   收尾回主界面 -> 决战检查（捐赠完回主界面再判：打完收工 / 没打完接着打）
            //   打够了 -> 只改提示文案（它是上限/卡住时的收工出口，动作仍是 StopTask）
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "宝箱循环-决战检查"
                    ]
                },
                "对战循环入口": {
                    "next": [
                        "[JumpBack]关掉卡牌已收到弹窗",
                        "[JumpBack]关掉奖励弹屏",
                        "奖励宝箱",
                        "结算界面",
                        "登录页",
                        "对战中",
                        "卡组页",
                        "宝箱循环-已完成",
                        "宝箱循环-开战",
                        "匹配中",
                        "未知界面处理"
                    ]
                },
                "点结算确定": {
                    "next": [
                        "宝箱循环-战后"
                    ],
                    "on_error": [
                        "宝箱循环-战后"
                    ]
                },
                "奖励宝箱": {
                    "on_error": [
                        "宝箱循环-进捐赠"
                    ],
                    "max_hit": 1500
                },
                "收尾回主界面": {
                    "next": [
                        "宝箱循环-决战检查"
                    ]
                },
                "打够了": {
                    "focus": "宝箱版循环结束（宝箱已打完 / 达到安全上限 / 长时间无法推进）—— 收工"
                }
            }
        },
        {
            "name": "退出游戏",
            "entry": "退出任务",
            "default_check": true,
            // 显式给一个空 option —— 其他 5 个任务都有 option，只有它没有。
            // 界面把任务写回配置文件时，字段不齐容易出岔子（实测这个实例曾「配置保存失败」）。
            "option": [],
            "description": "直接把游戏关掉，然后任务结束。不做前置动作、不拉起游戏。\n\n⚠️ 唯一的例外：如果画面停在**微信 / QQ 登录页**，会跳过关闭并判失败 —— 你正要手动登录，这时候把游戏关了最讨厌。"
        }
    ],
    // ⚠️ 原来这里有一个「跑几轮」输入框，靠 `日常-本轮.max_hit` 数轮数。
    // 2026-09-24 拆任务时**删掉了**：`max_hit` 用完不重置，导致「每轮打几局」
    // 根本没法成立（填 3 局 × 3 轮 = 第一轮连着打 9 局，后两轮跳过战斗）。
    // 现在轮数交给 MFAAvalonia 的重复次数控件（见「日常循环」任务的
    // repeatable / repeat_count）—— 每重复一次是新的一次任务，额度会归零。
    "option": {
        "商店翻几屏": {
            "type": "input",
            "label": "商店最多翻几屏",
            "description": "最多往下翻几屏（默认 20）。\n\n如果发现免费项没领到，把这个数调大再试。",
            "inputs": [
                {
                    "name": "屏数",
                    "label": "屏数",
                    "default": "20",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "商店滑一屏": {
                    "max_hit": "{屏数}"
                }
            }
        },
        "打几局": {
            "type": "input",
            "label": "每轮打几局",
            "description": "这一轮打满几局就停，然后去部落捐赠。\n\n单独跑「自动战斗」任务时，它就是这次任务总共打几局。\n\n第一次跑建议就用 1。",
            "inputs": [
                {
                    "name": "局数",
                    "label": "局数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "主界面": {
                    "max_hit": "{局数}"
                }
            }
        },
        "对战策略": {
            "type": "select",
            "label": "对战策略",
            "description": "决定它攒多少圣水才出牌。\n\n· 稳健推进：攒到 8 圣水再出（默认）。\n· 有费就出：5 圣水就出，出得更勤，一局打得更快。\n· 攒满再推：攒满 10 才出，出得最少但每次都是大单位。",
            "default_case": "稳健推进",
            // ⚠️ 三个 case 改的是「出牌-圣水够」的 roi 的 **x**，不是 custom_action_param。
            // 2026-09-23 转纯 JSON 之后没有 Python 自定义动作了，原来注入 custom_action_param
            // 的写法没人消费 —— 选了下拉也不会有任何变化（静默失效）。
            // 现在照 battle.json 的圣水位置竖条标定：x = 150 + 543 × N/10。
            "cases": [
                {
                    "name": "稳健推进",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [581, 1230, 6, 40]
                        }
                    }
                },
                {
                    "name": "有费就出",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [421, 1230, 6, 40]
                        }
                    }
                },
                {
                    "name": "攒满再推",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [688, 1230, 6, 40]
                        }
                    }
                }
            ]
        },
        "每次捐赠几张": {
            "type": "input",
            "label": "每次捐赠几张",
            "description": "一次进部落最多捐出多少张卡。\n\n⚠️ 游戏里点一下「捐赠」就把那个请求还差的卡全部捐出，没有「只捐一部分」的入口。所以这个数字是按「一个请求约 8 张」折算的，实际捐出张数会有出入。",
            "inputs": [
                {
                    "name": "张数",
                    "label": "张数",
                    "default": "8",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "部落捐一个": {
                    "max_hit": "{张数}"
                }
            }
        },
        "请求卡牌": {
            "type": "switch",
            "label": "顺便请求卡牌",
            "description": "捐完卡之后，顺手在部落聊天里发一次卡牌请求（默认开）。要请求哪张由下面「要请求的卡牌」下拉决定。\n\n⚠️ 请求有冷却（约 7 小时）。冷却中脚本什么都不点，不会误触花 2 宝石跳过冷却的确认框。\n⚠️ 这一步出任何岔子（认不到按钮 / 找不到卡）都不会让任务失败，会跳过继续。",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
