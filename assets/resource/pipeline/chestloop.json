{
    // ★ 宝箱循环（2026-10-15 新增）—— 「日常循环·打完宝箱版」专用节点。
    //
    // ══ 这一版在做什么（用户口径）══
    //   只看主界面中间那根「四个宝箱都领完」的紧凑木条（不再数局数）：
    //     · 木条在   -> 今日宝箱已打完 -> 收工，任务结束；
    //     · 木条不在 -> 打完一局 -> 进部落检查一次捐赠 -> 回来再判 -> 接着打。
    //   判据模板 `anchors/chest_bar_done.png` 验收（tools/_tmp_verify_strip.py +
    //   tools/_tmp_scan_mainscreen2.py，全语料 3848 帧 + 实机包 debug/on_error）：
    //     · 正样本 6 张（pos_a/b/c、pre_run、pre_run2、chest_state_now，全实拍）
    //       全部 1.0000，命中点固定 (246,879)；全语料里 29 张「已打完」主界面帧
    //       **最低 0.9969**；
    //     · 负样本（未打完的「活动」四宝箱面板，各子形态共 ~35 张）**最高 0.6144**，
    //       其中用户点名的 z_final 是 0.5878；
    //     · 唯一一个 0.8255 的 `shots/grid_now.png` 是**画了坐标网格线的调试帧**，
    //       不是真实游戏状态，恰好也被 0.85 的阈值挡在外面；
    //     ⇒ **阈值 0.85**：上侧余量 0.15+、下侧余量 0.23+，空档极宽。
    //
    // ══ 整条循环怎么串（一局的完整生命周期）══
    //   入口(宝箱循环-任务入口) -> 环境准备链 -> 主界面锚点
    //     -> 宝箱循环-决战检查        (起点先判一次：已打完就直接收工)
    //         未打完 -> 宝箱循环-开战  (点主界面「对战」按钮 = 开一局)
    //     -> 对战循环入口  (打牌/匹配/结算全走老链路，battle.json 原样复用)
    //     -> 结算界面 -> 点结算确定
    //     -> 宝箱循环-战后          (override 接的线；等开箱动画/弹窗过去)
    //     -> 宝箱循环-进捐赠        (确认回到主界面 -> 部落进入聊天)
    //     -> 部落扫屏…收尾回主界面   (捐赠链原样复用)
    //         收尾回主界面.next 被 override 到 宝箱循环-决战检查
    //     -> 宝箱循环-决战检查
    //         已打完 -> 宝箱循环-收工（StopTask，成功收工）
    //         未打完 -> 宝箱循环-开战 -> …… 每局如此循环
    //
    //   ⚠️ 为什么「检查」要做成哨兵(宝箱循环-决战检查) + 判据(宝箱循环-已完成)两个节点：
    //      参照 daily.json `部落扫屏` 的成熟写法 —— 哨兵是 DirectHit（永远命中），
    //      由它的 timeout 给判据节点一个「观望窗口」，窗口内没命中就走 on_error 去开战。
    //      反过来把判据节点直接挂进别人的 next，识别不到时没有兜底（next 耗尽 = 判失败）。
    //
    //   ⚠️ 为什么战后要绕 `宝箱循环-战后`/`宝箱循环-进捐赠` 两个节点才进捐赠链：
    //      「打完一局点完确定」之后画面不一定是主界面 —— 可能先播开箱动画
    //      （`奖励宝箱` 那种整屏橙色），而部落捐赠的第一步是点底部导航「社交」，
    //      在动画屏上根本点不到。所以先战后哨兵里等（把动画交给 `奖励宝箱` 处理），
    //      再用「主界面橙色」确认真的落地主界面了，才走 `部落进入聊天`。
    //      `宝箱循环-进捐赠` 的 orange 判据与「主界面锚点」「主界面」同一套 ROI/色域。
    //
    //   ⚠️ 开战上限 max_hit 40 = **安全上限**，不是用户设定：
    //      正常收工靠「宝箱已打完」判据；40 只是防「判据哪天失效 -> 无限打下去」。
    //      用尽后 `宝箱循环-开战` 在 next 里被跳过 -> `对战循环入口` 超时
    //      -> on_error -> `打够了` -> StopTask 收工（成功结束，界面不标红）。
    //      跑完一局约 2~4 分钟，40 局 ≈ 2~4 小时，中途宝箱打完了会提前收工。
    //
    //   ⚠️ 每局都过一遍捐赠链的代价（实为特性）：
    //      捐赠链里的 max_hit 都是「一次任务运行内共享」的额度 ——
    //      `部落翻页` 8 次、`部落捐一个` = 界面选项「每次捐赠几张」、`部落翻页` 的请求卡
    //      那一套 30 次。第一轮进聊天会深挖（翻页找请求），后面每轮只是「扫一眼当前屏」，
    //      额度用尽后自动变快 —— 不会每轮都翻满 8 屏。请求卡牌有 7 小时冷却，
    //      冷却中判据（「请求卡牌」vs「请求换卡」文字）会整步跳过，最多真正请求一次。
    "宝箱循环-任务入口": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        // 与 `循环任务入口` 同构：第一位是登录页守卫（掉登录态 -> 本任务判失败，
        // 后面的任务也不再跑）。入口节点**必须与其它任务不同名** ——
        // 同名入口在界面上会互相顶掉（见 main.json 顶部注释）。
        "next": ["登录页", "环境准备"]
    },
    // 哨兵：在主界面上判断「今日宝箱是否已打完」，给判据一个 1.5 秒观望窗口。
    // 命中 -> 已完成（收工线）；窗口内没命中 -> 开战（继续打）。
    // ⚠️ 起手就会先走它一次（主界面锚点 override 到这里），所以「宝箱本来就打完了」
    //    时任务会直接收工、一局都不打 —— 符合「打完就结束」。
    "宝箱循环-决战检查": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1500,
        "next": ["宝箱循环-已完成"],
        "on_error": ["宝箱循环-开战"]
    },
    // 判据：主界面中间那根「四宝箱已领完」的条体 —— 蓝色冠头木条的下沿 + 金色 V 饰边。
    // （裁图时把皇冠图标和漂浮动画全部裁掉，只留静止条体，这是标定时踩过的坑；
    //  roi 给条体四周各留 ~40~60px 余量：够吸收小位移，又不会框进别处 UI。）
    // ⚠️ 「未打完」态（活动四宝箱面板）各子形态在 roi 内最高只有 0.6144（全语料实测），
    //    已打完态全语料最低 0.9969 —— 阈值 0.85 落在 0.61~0.99 的宽空档里，
    //    并且挡住了调试帧那种「条体上被画了细线」的伪形态（0.8255）。
    // ⚠️ 2026-10-15 夜 补测：「皇冠」本身**不能**当判据（用户提示皇冠才是标志，故专门验证过，
    //    脚本 tools/_tmp_crown_check.py）——皇冠有上下漂浮动画（+光效），实测：
    //      · 整冠模板（含少量背景）在已打完帧上最低只 **0.4775**（一半帧匹配崩）；
    //      · 只退到蓝箍+金钻（48×23）稍稳（P10 0.9875）但最低仍 **0.7965** < 0.85，
    //        而且因为面积小、纹理平，**几乎所有帧都能打到 ~0.7**（全语料 90% 帧 ≥0.7 的通病），
    //        登录页等界面还有 0.8191~0.8238 的贴阈值假命中。
    //      ⇒ 只留**条体下沿**（皇冠条里唯一完全静止的部分）当判据，这是实测出来的最优解。
    "宝箱循环-已完成": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "anchors/chest_bar_done.png",
                "roi": [186, 839, 354, 112],
                "threshold": 0.85
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1000,
        "next": ["宝箱循环-收工"]
    },
    // 收工：StopTask = 任务**成功**结束（不是失败），界面上不会标红。
    // 此时人已经在主界面（检查是在主界面上做的），不用再做任何收尾动作。
    "宝箱循环-收工": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "StopTask", "param": {}},
        "focus": "四个宝箱都打完了 —— 收工！"
    },
    // 开一局：与 main.json `主界面` 同一套判据/动作/节奏（橙色色域 + 点对战按钮），
    // 只是把局数上限换成了**安全上限 40**（用户口径：宝箱版不设局数）。
    // ⚠️ 别改回 max_hit 1 之类的小值 —— 它是「一次运行内」的额度，用完不重置；
    //    宝箱版要一路打到宝箱完，额度必须覆盖整个任务生命周期。
    // ⚠️ 用尽之后：next/on_error 都回 `对战循环入口`，由它超时 -> `打够了` 收工。
    "宝箱循环-开战": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [244, 934, 250, 64],
                "method": 40,
                "lower": [5, 90, 140],
                "upper": [35, 255, 255],
                "count": 8000
            }
        },
        "action": {
            "type": "Click",
            "param": {"target": [369, 966]}
        },
        "max_hit": 40,
        "post_delay": 2500,
        "next": ["对战循环入口"],
        "on_error": ["对战循环入口"]
    },
    // 战后哨兵：点完结算「确定」之后的缓冲带（由「日常循环·打完宝箱版」override
    // 把 `点结算确定`.next / on_error 接到这里）。
    // 依次等这些过去：弹窗(JumpBack 关掉就走，回来重新等) -> 开箱动画 -> 主界面。
    // ⚠️ `奖励宝箱` 在这条链里出现是**故意的**：打完一局后必现的多阶段开箱动画，
    //    它的自环会把动画点完；动画结束时它的 on_error 被任务 override 接到
    //    `宝箱循环-进捐赠`（而不是默认的对战循环入口），所以「动画完 -> 捐赠」不断线。
    // ⚠️ timeout 10 秒只是「初始观望」的上限：命中任一候选项就立刻往下走，
    //    不会白等满（超过后走 on_error，兜底也是进捐赠）。
    "宝箱循环-战后": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 10000,
        "next": [
            "[JumpBack]关掉卡牌已收到弹窗",
            "[JumpBack]关掉奖励弹屏",
            "奖励宝箱",
            "宝箱循环-进捐赠"
        ],
        "on_error": ["宝箱循环-进捐赠"]
    },
    // 进捐赠的闸门：确认画面真的回到**主界面**（橙色对战按钮可见）才走
    // `部落进入聊天` —— 部落链第一步是点底部导航「社交」，在动画/弹层屏上点不到，
    // 硬走会变成对未知画面的盲点（`部落点聊天入口` 是 DirectHit 固定坐标）。
    // 主界面上的「卡牌已收到！」之类弹窗会压暗橙色 -> 先由 JumpBack 关掉再重判。
    "宝箱循环-进捐赠": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [244, 934, 250, 64],
                "method": 40,
                "lower": [5, 90, 140],
                "upper": [35, 255, 255],
                "count": 8000
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 3000,
        "next": [
            "[JumpBack]关掉卡牌已收到弹窗",
            "部落进入聊天"
        ],
        // 万一看不到主界面（卡在奇怪画面）：交回对战循环入口做通用恢复，
        // 别在这儿死等 —— 抢捐赠这件事不值得卡死整条链。
        "on_error": ["对战循环入口"]
    }
}
