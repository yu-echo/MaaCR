{
    // 本文件是 ProjectInterface V2 协议描述，告诉通用 UI（MFAAvalonia 等）
    // 这个项目要用哪些资源、有哪些任务可跑、各任务可以调什么参数。
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    //
    // 说明：本项目目前只做简体中文，所以界面文案直接写中文。
    // 以后要多语言：把要翻译的文案前面加 $ 前缀，再加 languages 字段指向
    // 翻译文件（扁平 key-value JSON）即可。
    "interface_version": 2,
    "name": "MaaCR",
    "title": "MaaCR · 皇室战争国服助手",
    // 界面里显示的图标。MFAAvalonia 的 IconHelper 只认这个字段（按数据目录解析），
    // 没写就会退回它自己内嵌的 logo.ico —— 这就是「换了 logo 但界面里没变」的原因。
    //
    // 特意用**深底**那张：浅色插画在 24px 的标题栏里会糊成一团白，深底才看得清。
    // 文件放在 assets/icon.png，手工组装发布包时要把它放到包根 ——
    // 开发时数据目录是 assets/、发布时是包根，相对路径 "icon.png" 两种布局都对得上。
    "icon": "icon.png",
    "version": "0.1.0",
    "license": "MIT",
    "github": "https://github.com/yu-echo/MaaCR",
    "description": "皇室战争国服（腾讯代理版）自动化助手：自动对战刷局，其余日常任务在移植中。\n\n基于 MaaFramework，界面由 MFAAvalonia 提供。\n\n⚠️ 目标是**快速刷完尽可能多的对局**（刷宝箱 / 对局时长 / 卡牌大师进度），**不是上分**。评估它好不好用请看**每局对战耗时**，不是胜率。",
    // 公告框左边那一栏很窄：文案一长就会被挤成一列一个字，所以这里只写一句话。
    "welcome": "第一次用之前请先看 README 的「使用前准备」。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            // 截图会缩放到「短边 720」。国服皇室战争是 720x1280 竖屏，
            // 缩放比正好 1:1 —— 所以 image/ 里的模板与 pipeline 里的坐标
            // 都是按 720x1280 量的，改这里就必须重采模板 + 重标坐标。
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服",
            "path": [
                "./resource"
            ]
        }
    ],
    // ⚠️ 这里**故意不设顶层 group、task 里也不写 group**。
    // group 是 PI v2.4.0 才加的字段，「通用 UI」版本低一点就可能认不出来 ——
    // 实测踩过：任务列表里一个任务都不显示，只剩「全局设置」，看着像任务没了。
    // 参考实现 MaaYuan 也是平铺列的（它的界面正常），所以就照这个来。
    "task": [
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "default_check": true,
            "description": "先把游戏准备妥当，再跑别的任务。\n\n它会做三件事：\n· 把模拟器屏幕点亮 —— 屏幕黑着的时候它截出来的图是黑的，什么也认不出来，很容易被误当成「脚本坏了」。\n· 把游戏切到最前面，并且等到游戏画面真的出来了才往下走。\n· 如果当前不是游戏（比如你切到别的 App 了），它会停下来提醒你，不会乱点。\n\n它只负责「准备好」，不负责打局。",
            "option": [
                "游戏版本"
            ]
        },
        {
            "name": "自动战斗",
            "entry": "启动检查",
            "default_check": true,
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "对战循环入口"
                    ]
                }
            },
            "description": "自动打对局：进游戏 → 出牌 → 打完一局 → 再开下一局，一直打到设定的局数。\n\n出牌策略用界面上的「**对战策略**」—— 它在全局设置里，所有打局的地方共用。\n\n认不出画面时它会自己想办法：先试着退回主界面，还不行就重开游戏。\n\n⚠️ 它的目标是 **快速刷完尽可能多的局**（刷宝箱、对局时长、卡牌大师进度），**不是上分** —— 所以「输」是正常的。它好不好用要看 **每局耗时**，不是胜率。",
            "option": [
                "打几局"
            ]
        },
        {
            "name": "领商店礼包",
            "entry": "商店任务",
            // ⚠️ 这个 override 是**必须的**，不是可有可无的润色。
            // 「环境准备」是 DirectHit，永远命中 —— 所以任何任务都会先走完整条启动链，
            // 最后停在「主界面锚点」上。而主界面锚点的 next 默认是**空的**，
            // 协议里 next 为空 = 任务终止。也就是说：不接这一根线，
            // 这个任务会在到达主界面之后就结束，商店逻辑一次都跑不到。
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "商店去商店页"
                    ]
                }
            },
            "description": "打开商店，把能白拿的东西领掉。\n\n走的是实测出来的真实路径：底部「商店」→ 左上「礼物盒」分类 → 「超值推荐」页签 → 往下翻到「每日精选」→ 点第一格的绿色「免费！」卡 → 弹窗里点绿色「免费！」按钮。\n\n⚠️ 商店那一页**非常长**：实测往下翻 30 屏还是付费项。所以它会**一屏一屏慢慢往下翻**（每屏停稳看清了再翻下一页，滑快了识别会漏），翻到底还是没有就跳过、收工回主界面 —— 不会卡住反复翻，也不会报错。\n\n只领免费的：那个绿色「免费！」按钮是**先认出来再点**的，不会瞎点坐标误领要花宝石的卡。",
            "option": [
                "领取内容",
                "商店翻几屏"
            ]
        },
        {
            "name": "部落捐赠",
            "entry": "部落任务",
            // 同上：不接这一根线，任务到主界面就结束了。
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "部落进入聊天"
                    ]
                }
            },
            "description": "进部落聊天，把能捐的卡捐出去。\n\n只点亮着的「捐赠」按钮 —— 按钮暗着的是「你没有这张卡」（界面上写着「您有 0/…」），捐不了。点一下就直接捐出去了。\n\n当前这屏没有能捐的，它会往上翻聊天记录找，最多翻 8 屏；翻到底还是没有就跳过、收工。\n\n⚠️ 游戏不允许「只捐一部分」：点一下就把这个请求还差的那几张全捐出，所以下面的数字是折算出来的，不是精确张数。\n\n捐完之后才点一次底部的「确定」—— 那是退出聊天的按钮，每捐一次都点它会直接退出来，所以只在最后点一下。",
            "option": [
                "每次捐赠几张"
            ]
        },
        {
            "name": "日常循环",
            "entry": "循环任务入口",
            // ★ 重复次数用 MFAAvalonia 的扩展字段 —— ProjectInterface V2 协议本身没有。
            // 官方 README：「MFAAvalonia 在 Project Interface V2 的 task 项中额外支持
            //   repeatable / repeat_count」，开了之后界面里会多一个重复次数控件，
            //   在界面改的值随实例配置保存。
            // 为什么必须借客户端：pipeline 的 `max_hit` 是「一次任务运行内的额度」，
            //   用完不重置，所以「每轮打几局 × 跑几轮」在纯 JSON 里乘不出来
            //   （填 3 局 × 3 轮会变成第一轮连打 9 局、后两轮跳过战斗）。
            //   客户端每重复一次 = **新的一次任务运行** -> 额度归零，「每轮」才是真的每轮。
            // ⚠️ MaaPiCli 与其他客户端不认这两个字段，在 CLI 里只能验证单轮逻辑。
            "repeatable": true,
            "repeat_count": 1,
            "description": "一轮 = **自动战斗（打几局）+ 部落捐赠（捐一次）**，跑完回主界面结束；下一轮由客户端自动接着开始。\n\n**「跑几轮」用这个任务的「重复次数」控件设置**（默认 1）。之所以不给一个「跑几轮」输入框：流水线的计数额度是一次运行内只减不增的，填「3 局 × 3 轮」会变成第一轮连打 9 局、后两轮不打了；交给客户端重复，每轮才是真的每轮。\n\n⚠️ 这个「重复次数」是 MFAAvalonia 的扩展功能，命令行版 MaaPiCli 等客户端可能没有 —— 在那些客户端里它只跑一轮。",
            "option": [
                "打几局",
                "每次捐赠几张"
            ],
            "pipeline_override": {
                "主界面锚点": {
                    "next": [
                        "对战循环入口"
                    ]
                },
                "打够了": {
                    "action": {
                        "type": "DoNothing",
                        "param": {}
                    },
                    "next": [
                        "部落进入聊天"
                    ]
                }
            }
        },
        {
            "name": "退出游戏",
            "entry": "退出任务",
            "description": "直接把游戏关掉，然后任务结束。\n\n它**不做任何前置动作** —— 不拉起游戏、不回主界面，也没有选项。\n\n放在「日常一条龙」预设的最后一步，作用就是「跑完收工、把游戏关掉」；不选它，游戏会一直开着。"
        }
    ],
    // ⚠️ 原来这里有一个「跑几轮」输入框，靠 `日常-本轮.max_hit` 数轮数。
    // 2026-09-24 拆任务时**删掉了**：`max_hit` 用完不重置，导致「每轮打几局」
    // 根本没法成立（填 3 局 × 3 轮 = 第一轮连着打 9 局，后两轮跳过战斗）。
    // 现在轮数交给 MFAAvalonia 的重复次数控件（见「日常循环」任务的
    // repeatable / repeat_count）—— 每重复一次是新的一次任务，额度会归零。
    "option": {
        "商店翻几屏": {
            "type": "input",
            "label": "商店最多翻几屏",
            "description": "最多往下翻几屏。\n\n⚠️ 现在这只是**兜底预算**，正常用不到 —— 免费的每日礼物固定放在「每日精选」那块的第一格，**翻到那一屏就做判断**：有就领、没有就收工。实测只滑 17～23 屏，整段 1 分 40 秒 ～ 2 分 14 秒。\n\n只有「每日精选」一直认不出来时（比如游戏改版换了标题），才会一路滑到这个屏数。默认 60 是留足余量。",
            "inputs": [
                {
                    "name": "屏数",
                    "label": "屏数",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "商店滑一屏": {
                    "max_hit": "{屏数}"
                }
            }
        },
        "打几局": {
            "type": "input",
            "label": "每轮打几局",
            "description": "这一轮打满几局就停，然后去部落捐赠。\n\n⚠️ 单独跑「自动战斗」任务时，它就是**这次任务总共打几局**（那边只有一轮）；\n在「日常循环」里，因为每轮都是新的一次任务，它才是真的**每轮**打几局。\n\n第一次跑建议就用 1，看着它打完一局再说。",
            "inputs": [
                {
                    "name": "局数",
                    "label": "局数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "主界面": {
                    "max_hit": "{局数}"
                }
            }
        },
        "对战策略": {
            "type": "select",
            "label": "对战策略",
            "description": "决定它攒多少圣水才出牌。\n\n· 稳健推进：攒到 8 圣水再出，中规中矩（默认）。\n· 有费就出：5 圣水就出，出得更勤，一局打得更快。\n· 攒满再推：攒满 10 才出，出得最少，但每次都是大单位。\n\n圣水越早花掉、回蓝越不浪费，所以「有费就出」通常刷局更快；「攒满再推」最慢，那只是旧脚本留下的习惯。",
            "default_case": "稳健推进",
            // ⚠️ 三个 case 改的是「出牌-圣水够」的 roi 的 **x**，不是 custom_action_param。
            // 2026-09-23 转纯 JSON 之后没有 Python 自定义动作了，原来注入 custom_action_param
            // 的写法没人消费 —— 选了下拉也不会有任何变化（静默失效）。
            // 现在照 battle.json 的圣水位置竖条标定：x = 150 + 543 × N/10。
            "cases": [
                {
                    "name": "稳健推进",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [581, 1230, 6, 40]
                        }
                    }
                },
                {
                    "name": "有费就出",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [421, 1230, 6, 40]
                        }
                    }
                },
                {
                    "name": "攒满再推",
                    "pipeline_override": {
                        "出牌-圣水够": {
                            "roi": [688, 1230, 6, 40]
                        }
                    }
                }
            ]
        },
        "每次捐赠几张": {
            "type": "input",
            "label": "每次捐赠几张",
            "description": "一次进部落最多捐出多少张卡。\n\n⚠️ 这里要说实话：游戏里点一下「捐赠」就把那个请求还差的卡**全部**捐出（界面上显示的是「收到的卡牌 24/40」这种进度），没有「只捐一部分」的入口。所以这个数字没法精确控制，程序是按「一个请求约 8 张」折算成「捐几次」的，实际捐出的张数会跟这里填的有出入。\n\n当前这屏没有能捐的，它会往上翻聊天记录找，最多翻 8 屏。",
            "inputs": [
                {
                    "name": "张数",
                    "label": "张数",
                    "default": "8",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "部落捐一个": {
                    "max_hit": "{张数}"
                }
            }
        },
        "游戏版本": {
            "type": "select",
            "label": "游戏版本",
            "description": "选要启动哪个版本的皇室战争。\n\n目前只有国服（腾讯代理版）一个 —— 下拉先按「以后要加渠道服」的样子搭好，加一个只要补一行配置。\n\n选了哪个，启动前就会去设备上确认装了没有；没装会直接停下提醒你，不会乱点。",
            "default_case": "国服",
            "cases": [
                {
                    "name": "国服",
                    "pipeline_override": {
                        "拉起游戏": {
                            "action": {
                                "type": "StartApp",
                                "param": {
                                    "package": "com.tencent.tmgp.supercell.clashroyale"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "领取内容": {
            "type": "checkbox",
            "label": "领取内容",
            // ⚠️ 两个 case 都**故意不带 pipeline_override**。
            // 纯 JSON 化之后，这两类东西的领取逻辑写在流水线里分不出来 ——
            // 区别只是「商店里长什么样的东西算数」，而流水线认的判据是同一套
            // （OCR 认「免费」两个字 + 拉到底就跳过）。所以这里是**声明式**的：
            // 选了哪个，就表示你希望它去扫哪一类；扫不到不会报错，会拉到底然后跳过。
            // 2026-09-24：case 名按用户口径从「维护礼物」改成「维护补偿」（同一个东西）。
            "description": "选这次去商店扫哪几类东西，**默认两个都选**。\n**扫不到不会报错，翻到底就自动跳过**，接着扫下一个。\n\n· 每日免费礼物：商店里标着「免费」的东西，每天一次。\n· 维护补偿：官方发维护补偿时商店会挂出来。**目前游戏里没有这个入口**，所以现在选上它会扫一遍、翻到底、然后跳过 —— 等官方真发了，补上识别模板就能用，界面这里不用再改。\n\n⚠️ 「每天只领一次、跨天自动恢复」不是靠脚本记账，而是**游戏自己重置**：领过的格子当天显示「已收集！」，第二天变回「免费！」。所以脚本不用管，扫到就领、扫不到跳过即可。",
            "default_case": [
                "每日免费礼物",
                "维护补偿"
            ],
            "cases": [
                {
                    "name": "每日免费礼物"
                },
                {
                    "name": "维护补偿"
                }
            ]
        }
    },
    // 「对战策略」是**所有打局的地方共用**的一个参数，所以放在这里（全局设置区），
    // 而不是绑在某个任务上 —— 切任务时它不跟着变，界面上只出现这一处。
    // （2026-09-24：先按用户要求挪进过任务，用户看过界面后要求挪回来。）
    "setting": [
        {
            "name": "battle_setting",
            "label": "全局设置",
            "description": "对所有任务生效。",
            "option": [
                "对战策略"
            ]
        }
    ],
    "preset": [
        {
            "name": "日常一条龙",
            "description": "一把跑完，不用你盯着换任务：\n\n**启动游戏 → 领商店礼包 →（自动战斗 + 部落捐赠）× 跑几轮 → 退出游戏。**\n\n· 「启动游戏」和「领商店礼包」**只做一次**，不在循环里；\n· 「日常循环」任务负责**一轮** = 打几局 + 捐一次 —— **跑几轮用它的「重复次数」控件设置**；\n· 最后的「退出游戏」**把游戏关掉**。\n\n想只跑某一步的话，用任务列表里那几个单项任务（自动战斗、部落捐赠就是单跑用的）。",
            "task": [
                {
                    "name": "启动游戏",
                    "enabled": true
                },
                {
                    "name": "领商店礼包",
                    "enabled": true
                },
                {
                    "name": "日常循环",
                    "enabled": true
                },
                {
                    "name": "退出游戏",
                    "enabled": true
                }
            ]
        },
        {
            "name": "日常任务（不含对战）",
            "description": "先把游戏准备好，再领商店礼包 + 部落捐赠，各跑一遍，跑完自动回主界面。不打对战、不关游戏。",
            "task": [
                {
                    "name": "启动游戏",
                    "enabled": true
                },
                {
                    "name": "领商店礼包",
                    "enabled": true
                },
                {
                    "name": "部落捐赠",
                    "enabled": true
                }
            ]
        }
    ]
}
