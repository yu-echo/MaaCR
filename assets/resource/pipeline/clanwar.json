{
    // ★ 部落战（河道竞速）—— 2026-10-11 新增，用户要求「自动打部落战」。
    //
    // 一轮 = 从部落战地图上点「对战」→ 用当前可用的卡组开打（挂机等结算）→ 回到地图再来一次，
    //        最多 4 次（每天 4 个卡组各一次）就算完成。
    //
    // ⚠️ 这一整套界面**不能写死坐标**：部落战地图是**可滚动的河道**，
    //    那个「盾牌+双剑」的对战图标会随镜头漂移 —— 用户给的两张截图里它就在两个不同位置
    //    （720x1280 下 (630,728) 与 (630,436)）。所以一律走全屏 TemplateMatch 点识别框中心。
    //
    // ⚠️ 用户明确交代的三条：
    //    ① 开战日那种弹窗（「对战日结果」「每日排名 / 防御」）**不要点「确定」**，
    //       点「点击以继续」那种**空白处**继续 —— 见 `部落战-点空白继续`；
    //    ② 排队 3 分钟还没开打就点「取消」、跳过这个任务 —— 见 `部落战-等开局`(timeout 180000)
    //       → `部落战-取消排队`。用户 2026-10-18 拍板从 1 分钟放宽到 3 分钟（周日中午 60 秒排不到人）；
    //    ③ 战斗里卡组是**随机**的：认得出的牌按 battle.json 那套费用策略正常出；
    //       认不出的牌**随机丢**（2026-10-15 用户口径「随便丢点就行」）—— 见 `部落战-乱丢-选牌`。
    //
    // 素材（全部 2026-10-11 从模拟器**原生 720x1280** 帧直裁，工具 tools/make_template.py）：
    //    clanwar/tab_clanwar.png   顶部栏那个「部落战」按钮（181x171，正 0.9874）
    //    clanwar/icon_attack.png   地图上「蓝气泡+盾牌双剑」对战图标（66x80，正 1.0000 / 另一帧 0.9687 / 负样本 0.5169）
    //    clanwar/btn_pvp.png       对战弹窗里那个金色「对战」键（206x96，正 1.0000 / 负样本 0.3368）
    //    clanwar/battle_next.png   战斗画面左下「下一张：」（正=真实战斗帧 1.0000；非战斗帧 4 张 1.0 —— 那 4 张本来就是战斗画面被误标成「未知界面处理」）
    //    clanwar/battle_timer.png  战斗画面右上「剩余时间」（同上，0.948~0.974 / 那 4 张同为战斗帧）
    //  ⚠️ 战斗锚点用两个特征兜底：单看一个会漏（实测 343 张战斗帧里，有的帧 HUD 还没出来，两个模板各自的最低分只有 0.21 / 0.41）。

    // 入口：和其它任务一样，先过「未登录守卫」再走启动链。
    // 到主界面之后去哪儿，由 interface.json 的任务级 override 注入（-> 部落战-进社交页）。
    "部落战任务": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["登录页", "环境准备"]
    },

    // ① 点底部导航「社交」。点完可能有两种落点：社交成员列表（有顶部栏）或**已经**在部落战地图里
    //    （游戏会记住上次停在哪一页）—— 所以 next 里先试「部落战」按钮，没有再直接清障。
    "部落战-进社交页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "nav/social.png", "roi": [0, 1140, 720, 140], "threshold": 0.6}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["部落战-找部落战入口", "部落战-清障"],
        "on_error": ["部落战-清障"]
    },
    // ② 顶部木质栏上的三个按钮：WIN / 部落战 / 聊天。认中间那个进部落战。
    "部落战-找部落战入口": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/tab_clanwar.png", "threshold": 0.8}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 3000,
        "next": ["部落战-清障"],
        "on_error": ["部落战-清障"]
    },
    // ③ 部落战页面的清障哨兵：跟 `清障链` 一个套路 —— 先关弹窗，再认主界面，认不出就滑一下再试。
    //    ⚠️ 「部落战-再等等」是 DirectHit 兜底，**必须排最后**、且靠 max_hit 当重试预算，
    //       预算用完后它被跳过 -> 本节点的 next 耗尽 -> on_error -> 收工。
    "部落战-清障": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 8000,
        "next": [
            "[JumpBack]关掉卡牌已收到弹窗",
            "[JumpBack]关掉奖励弹屏",
            "部落战-关最终奖励页",
            "部落战-关战日开始",
            "部落战-关结束弹窗",
            "部落战-亮奖推进",
            "部落战-点空白继续",
            "部落战-主界面锚点",
            "部落战-再等等"
        ],
        "on_error": ["部落战-收工"]
    },
    // ③b 战争结束结算弹窗（「您的部落未能抵达终点！」，2026-10-14 用户报告）：
    //    点「部落战」按钮等几秒后弹出，带遮罩 —— 部落战-主界面锚点(OCR) 等全部失效，
    //    部落战-清障 空转到 on_error（现场帧 `2026.10.14-20.17.37.113_部落战-清障.png`，
    //    就是 run_eventpopup.log 卡住那局）。
    //    ⚠️ 认**中间的盾牌徽记**不认文案：战况不同文案会变（胜/负/到没到终点），盾牌不变。
    //    素材 `war_end_shield.png` = 盾牌内芯 150x160（从原生帧直裁）：
    //    正样本 1.0000；2910 帧负样本最高 0.6637，≥0.8 的 3 帧全是这同一个弹窗 ⇒ 0.8 落宽空档。
    //    ⚠️ 2026-10-15 用户明确交代：这个弹窗要点黄色键上的「**打开**」领奖励
    //       （键上的奖励物会变，昨天是「奖励靴」，别认物名，只认「打开」两个字），
    //       点「确定」是不领直接关 —— 改成认出弹窗后先去点「打开」。
    //    命中后交给 `部落战-开奖励靴`（OCR「打开」）去点；OCR 认不到就退回
    //    `部落战-点确认`（确定）兜底，至少不会卡死。
    //    点完确定/领完奖励 -> `部落战-收尾` 统一收尾（奖励亮出动画/确定/重进都有人接）。
    //    弹窗若再弹会再被关（max_hit 3 封顶，防死循环）。
    "部落战-关结束弹窗": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/war_end_shield.png", "threshold": 0.8}
        },
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 300,
        "max_hit": 3,
        "next": ["部落战-开奖励靴"],
        "on_error": ["部落战-点确认"]
    },
    // ③b2 「对战日已开始！」弹窗（2026-10-15 新赛季实机走查确认）：
    //    点「部落战」按钮后可能先弹「最终奖励」页（③d 关掉）再弹这颗，点「确定」后才落地图。
    //    ⚠️ 这颗弹窗顶上的盾牌与战争结束弹窗的盾牌是**近亲**：war_end_shield 在它身上
    //       打 0.8303（>0.8）—— 若排在 关结束弹窗 后面会被误认、跑进「开奖励靴」死胡同。
    //       所以必须排在 关结束弹窗 **前面**，靠它自己的底部蓝「确定」（实测 ~(336,1024)，
    //       与地图底部那颗 y~1230 的退出确定、最终奖励页底部 y~1195 的确定都不重叠）拦下。
    //    ⚠️ 横幅别用 OCR「对战日已开始」：与「最终奖励」同款紫底白字，白字掩码在紫底上
    //       实测 0 命中（见 ③d）。认「确定」最稳。
    "部落战-关战日开始": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [200, 950, 340, 160],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "max_hit": 3,
        "next": ["部落战-清障"],
        "on_error": ["部落战-清障"]
    },
    // ③c 「奖励靴 打开」黄键（2026-10-15 新增）：弹窗固定版式，黄键实测在
    //    (224,700)-(510,820)，roi 只框左半文字区（右侧是会变的奖励物图标，别框进来）。
    //    「打开」是白字黄底 —— 白字掩码靠黄底高饱和与白字低饱和分开，与
    //    `部落战-点确认` 同一套写法。
    //    ⚠️ 2026-10-15 实机：点「打开」后是**逐件亮奖界面**（奖励靴叼着一摞奖励，
    //    卡牌一张张翻开，右上角红色数字 = 剩余件数，实测 4），点屏幕中央推进 ——
    //    这正是 `关掉奖励弹屏` 的动作，但它那两个模板（紫金宝箱/金星）认不出靴子，
    //    所以本文件另立 `部落战-亮奖推进`（认靴子本体），点完仍由它 JumpBack 回来。
    "部落战-开奖励靴": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "打开",
                "roi": [230, 690, 290, 140],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "max_hit": 3,
        "next": ["部落战-亮奖推进"],
        "on_error": ["部落战-收尾"]
    },
    // ③d 「最终奖励」战报页（2026-10-15 用户报告）：亮奖点完 / 重进部落战页时可能停在
    //    这页 —— 顶部盾牌徽记比例和结束弹窗那颗不同（war_end_shield 只有 0.6266），
    //    认不出就会让清障空转收工、页还留在屏上挡后续任务。
    //    判据 = 紫色横幅「最终奖励」`clanwar/summary_banner.png`（固定表头，白字紫底）。
    //    ⚠️ 别用 OCR「最终奖励」+ 白字掩码：实测 0 命中（19:53 run_summary.log 连空 12 轮），
    //       这个紫底上白字掩码不好使。模板正 1.0000 / 负样本里 ≥0.8 的 7 帧全是本页历史帧。
    //    命中后走 `部落战-关最终-确定`（OCR「确定」，页面上中部紫色/底部蓝色两颗都在它的 roi 里）。
    //    ⚠️ 收法 2026-10-15 晚修订 = 点掉确定 -> **回清障链**：新赛季开打时点掉这页
    //       还要接「对战日已开始」弹窗再落地图，收工=白丢一个对战日；战争结束期点完
    //       落社交页，清障空转 ~10s 后自然收工（见 关最终-确定 内注释）。
    //       （旧版「直接收工」是战争结束期实测出来的正确收法，但新赛季场景不成立。）
    "部落战-关最终奖励页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/summary_banner.png", "threshold": 0.8}
        },
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 300,
        "max_hit": 3,
        "next": ["部落战-关最终-确定"],
        "on_error": ["部落战-收工"]
    },
    // 「最终奖励」页的确定键：页面上中部紫色 + 底部蓝色两颗，roi 一并框住
    // （紫键 ~(250,1090)-(475,1180)，蓝键 ~(260,1195)-(460,1280)，实机 2026-10-15 量得）。
    // ⚠️ 2026-10-15 踩过：`部落战-点确认` 的 roi [250,1180,240,100] 在这页上
    //    OCR 框到的是两颗键**之间**的空档（点击 y1232 落空，页面纹丝不动）——
    //    所以这页用自己的确定节点，别复用 点确认。
    "部落战-关最终-确定": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [200, 1090, 340, 190],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "timeout": 5000,
        "max_hit": 3,
        // ⚠️ 2026-10-15 晚改：next 回**清障链**而不是收工 —— 新赛季开打时这页点掉
        //    之后还会跟「对战日已开始」弹窗、再落地图，收工就把仗丢了。
        //    战争结束期点完这页落在社交页：清障里啥都认不出 -> 再等等 x5（~10s）-> 收工，
        //    只是多耗 10 秒，行为可接受。
        "next": ["部落战-清障"],
        "on_error": ["部落战-清障"]
    },
    // 亮奖界面的推进节点：认奖励靴本体（点开动画/亮出奖励时它都在屏上），
    // 点屏幕中央翻下一件。max_hit 10 > 实测 4 件，防跑飞。
    // ⚠️ post_delay 2500：实测翻下一件有 ~2s 的翻卡动画，动画期间靴子被挡住
    //    （模板 0.87 → 落到 <0.8），回环重评估太快会提前断 —— 慢一拍等它亮稳。
    // ⚠️ 回环用**自环**（next 指自己），不用 [JumpBack]：2026-10-15 实测
    //    [JumpBack] 从「启动检查」直接挂时只回跳了一次就收工（run_boot2.log，
    //    靴子还在屏上任务就 Succeeded 了），自环行为完全自己掌控。
    //    靴子消失（亮完）→ 4s 内认不到 → on_error 落 `部落战-点确认`
    //    （亮完若回弹窗有「确定」就点掉；没有就往下走）。
    // 验收：正样本 亮奖帧 0.8660 / 亮完 1.0000；3867 帧负样本最高 0.3881 ⇒ 阈值 0.8 落宽空档。
    "部落战-亮奖推进": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/reward_boot.png", "threshold": 0.8}
        },
        "action": {"type": "Click", "param": {"target": [360, 540]}},
        "post_delay": 2500,
        "timeout": 4000,
        "max_hit": 10,
        "next": ["部落战-亮奖推进"],
        "on_error": ["部落战-收尾"]
    },
    "部落战-再等等": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 2000,
        "max_hit": 5,
        "next": ["部落战-清障"]
    },
    // ④ 开战日弹窗（「对战日结果」/「每日排名 + 防御」）：**点空白处继续，不点确定**。
    //    这两个弹窗下半部都写着「点击以继续」—— 点它文字本身就等于点空白。
    //    ⚠️ 不带 color_filter：那行字是**浅灰**不是纯白，套「白字掩码」会把它滤没。
    "部落战-点空白继续": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "点击以继续",
                "roi": [150, 1080, 420, 90],
                "threshold": 0.3
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 1500,
        "max_hit": 10,
        "next": []
    },
    // ⑤ 部落战主界面锚点 = 顶部那条「第 N 个训练日 / 第 N 个对战日」横幅（白字）。
    //    ⚠️ 2026-10-19 修：原 expected 只写「对战日」，但新赛季**第 1 天叫「训练日」**——
    //       当天实机帧 OCR 读到 `第1个训练日 score=0.994982`、仍然判 Failed，
    //       于是锚点一次都没命中 → 清障空转 32 秒 → on_error 收工，一局没打
    //       （run_cw1019.log，20:26:57~20:27:29）。两个词都得认。
    //    ⚠️ 训练日也能打（点对战气泡 → 「决斗」弹窗，3 局 2 胜、用 3 套卡组），
    //       所以训练日不是「没事干」，只影响能不能拿奖章。
    "部落战-主界面锚点": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["对战日", "训练日"],
                "roi": [140, 18, 440, 64],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 3000,
        // ⚠️ 顺序「先下滑再上滑」（2026-10-18 改）：进图默认停在河道**下游底部**（镜头已到底，
        //    上滑根本不滚），对战图标在上游 ⇒ 必须先往下拖。三次实机全是「上滑 12 次全空、
        //    下滑第 1 次命中」（10-15 live、10-18 11:28、10-18 12:59），白耗 ~40 秒。
        "next": ["部落战-点对战图标", "部落战-往下滑", "部落战-往上滑"],
        "on_error": ["部落战-收工"]
    },
    // ⑥ 「往上滑」= 手指上拖（镜头往下、看更靠下游的一段）。
    //    ⚠️ max_hit 8（原 12）：不是「只滑 8 次」，而是整个任务（最多 4 局）共享的滑动预算。
    //       每局最多用 1~2 次（实测一次就能把气泡滑进画面），8 次够 4 局用。
    //       2026-10-19 实测：本赛季初始机位看不到气泡，**上滑 1 次即命中**（icon_attack 0.9965）。
    "部落战-往上滑": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [360, 900, 1, 1],
                "end": [[360, 330, 1, 1]],
                "duration": 700
            }
        },
        "post_delay": 1500,
        "max_hit": 8,
        "next": ["部落战-清障"]
    },
    // ⑥b 「往下滑」= 手指下拖（镜头往上、看上游）。
    //    ⚠️ max_hit 4（原 12）：2026-10-19 实测本赛季这个方向**滑 3 次都不出气泡**
    //       （icon_attack 稳定 0.467），有效方向是上滑。给 12 会让第一局先白滑 12 次（~24 秒）
    //       才轮到 `部落战-往上滑`。压到 4 = 允许它先试错 4 次，之后预算耗尽自动落到上滑。
    //       若某赛季反过来（10-18 就是下滑命中），4 次也够每局 1 次、打完 4 局。
    "部落战-往下滑": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [360, 400, 1, 1],
                "end": [[360, 950, 1, 1]],
                "duration": 700
            }
        },
        "post_delay": 1500,
        "max_hit": 4,
        "next": ["部落战-清障"]
    },
    // ⑦ 地图上那个「盾牌 + 双剑」的蓝色气泡 = 对战。
    //    ⚠️ max_hit 8（原 4）：8 是**点击预算**，不是「今天还能打几局」——真正的上界由游戏给
    //       （卡组用完时弹窗里金色「对战」键会变灰，由 ⑦c `部落战-卡组用完` 判掉 → 收工；
    //        2026-10-19 更正：灰钮的模板分其实是 **0.999**，不是旧注释写的 0.784，
    //        「靠 ⑧ 判不出来来兜底」这条**不成立**，见 ⑦c）。
    //       给 4 的话，一次点空就少打一局，太紧。
    //    ⚠️ 全屏搜（不锁 roi）—— 图标会随镜头漂移；负样本最高只有 0.5169。
    //    ⚠️ 地图**必须滑动才能露出气泡**（用户 2026-10-18 确认口径）：默认停的机位常常看不到它，
    //       所以「点不到」要先交给 主界面锚点 去滑，别当成没卡组。
    //    ⚠️ **点空不能收工**（2026-10-18 实机事故）：气泡在屏上、分 0.920、点下去没反应
    //       （别的人在打时气泡会短暂不可用），脚本一次失败就 StopTask，报「卡组打完了」，
    //       而弹窗里实际还有 ⏱/2/3/4 三组可用。改成先重试，重试预算用完才收工。
    //    ⚠️ `timeout: 4000`：2026-10-11 原意是「卡组用完、⑧ 判不出来时别白等 20 秒」。
    //       2026-10-19 更正：灰钮现在能被 ⑧ 认出来（0.999），所以这条不再是兜底路径，
    //       4 秒只当「点了气泡但弹窗没弹」的短窗口用。
    "部落战-点对战图标": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/icon_attack.png", "threshold": 0.8}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "timeout": 4000,
        "max_hit": 8,
        "next": ["部落战-卡组用完", "部落战-对战弹窗"],
        "on_error": ["部落战-没弹对战窗", "部落战-收工"]
    },
    // ⑦c 弹窗开着、但金色「对战」键**是灰的** = 本轮卡组已经打完（不是「认不出弹窗」）。
    //    ⚠️ 必须单独判的理由：`btn_pvp.png` 走的是**灰度**模板匹配（CCOEFF 归一化后
    //       对颜色几乎免疫）—— 2026-10-19 实测灰钮打分 **0.999**，
    //       旧注释里「灰了就只有 0.784、⑧ 自然判不出来」**已经不成立**。
    //       于是 ⑧ 会高高兴兴地点一个点不动的键，连点 4 轮
    //       （09:13:14 / 26 / 39 / 51 四张 on_error 帧）才走到收工，报的话也含糊。
    //       判据只能看**颜色**：灰钮 S 中位数 = 0（实测该 ROI 里 18578/28800 px 落在
    //       S<=45 & V<=235），橙钮是 H≈21 / S≈174 / V≈253。
    //       同一 ROI 在 200 帧负样本里最高只有 7093 px（登录页），阈值取 12000 两边都干净。
    //    ⚠️ 外面再套一层 TemplateMatch 当守卫：没有弹窗时 btn_pvp 只有 0.197，
    //       不会把地图上的灰石头当成灰钮。
    //    动作 = 点弹窗右上角红叉 (638,315)（popup_close 实测命中框在 (616,293) 46x48），
    //    免得弹窗挡着后面的任务；万一没点掉，下个任务的清障链也会再关一次。
    "部落战-卡组用完": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "弹窗在",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {"template": "clanwar/btn_pvp.png", "threshold": 0.8}
                        }
                    },
                    {
                        "sub_name": "键是灰的",
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [360, 780, 240, 120],
                                "method": 40,
                                "lower": [0, 0, 150],
                                "upper": [180, 45, 235],
                                "count": 12000
                            }
                        }
                    }
                ]
            }
        },
        "action": {"type": "Click", "param": {"target": [638, 315]}},
        "post_delay": 1000,
        "next": ["部落战-卡组用完-收工"]
    },
    "部落战-卡组用完-收工": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "StopTask", "param": {}},
        "focus": {
            "Node.Action.Starting": {
                "content": "**部落战这轮没得打** —— 弹窗开着，但金色「对战」键是**灰的**，说明本轮 4 个卡组都打完了（或者还没轮到你）。已经把弹窗关掉了，部落战任务到此收工；下一个对战日会再试。",
                "display": ["log"]
            }
        }
    },
    // ⑦b 点了气泡但「对战」窗没弹出来：回清障链重扫再看一遍（气泡可能刚好不可用），
    //     给 3 次预算；用完这个节点被跳过 -> 落到 ⑦ 的 on_error 尾部 收工。
    "部落战-没弹对战窗": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 1500,
        "max_hit": 3,
        "next": ["部落战-清障"]
    },
    // ⑧ 弹窗里那个金色「对战」键：**认出它就点**（同一个节点兼「我在弹窗里」的判据）。
    //    弹窗是固定版式（两次实测金色键都在 (376,793,206,96)），但这里仍然走识别而不是写坐标。
    //    ★ 2026-10-18 实机看清弹窗结构：卡组栏是「⏱ | 2 | 3 | 4」——
    //      ⏱ = 该组在冷却（用户口径：转动的时针），数字 = 可选卡组，**自动选中第一个可用组**
    //      （实测选中 2 并高亮）。所以这里**不需要额外选卡组**，认到金色键直接点即可。
    "部落战-对战弹窗": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "clanwar/btn_pvp.png", "threshold": 0.8}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["部落战-等开局"],
        "on_error": ["部落战-收工"]
    },
    // ⑨ 排队上限 3 分钟（2026-10-18 用户拍板放宽，原 60 秒）：3 分钟内看到战斗画面就进战斗，
    //    没看到就落 on_error 去取消。
    //    （「搜索对手」那一屏的「预计时间 X 分钟」只是估计值，不读它。）
    //    ⚠️ 为什么放宽：2026-10-18 周日中午连跑两轮，都是 60 秒内没排到对手 → 取消收工，
    //       一局没打成；实际那天的匹配等待明显超过 1 分钟。
    "部落战-等开局": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 180000,
        "next": ["部落战-战斗锚点", "部落战-结算"],
        "on_error": ["部落战-取消排队"]
    },
    // ⑩ 战斗画面锚点：两个特征取最高分即「Or」。
    //    卡组是随机的 -> 绝不能像天梯那样靠手牌模板判「在不在战斗里」（那 10 张卡不一定有）。
    "部落战-战斗锚点": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["clanwar/battle_next.png", "clanwar/battle_timer.png"],
                "threshold": 0.8
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 500,
        "next": ["部落战-战斗中"],
        "on_error": ["部落战-战斗中"]
    },
    // ⑪ 战斗中循环：**每一轮先看结算有没有出来，没出来就试着按现有的出牌链路打一张**。
    //
    //    ⚠️ 为什么不用 battle.json 的 `对战中` 当判据：那一版的判据是
    //        `And(圣水条 + 手牌里有那 10 张已知卡之一)` —— 部落战卡组是**随机**的，
    //        手牌里一张都不认识的话它根本不命中，就会掉进 `未知界面处理` → `未知-点弹层`
    //        去**乱点屏幕中间**。所以这边用上面那个与卡组无关的战斗锚点。
    //    ⚠️ 出牌是**能认就出、认不出就乱丢**：`出牌-圣水够` 只认那 8~10 张牌，
    //       随机卡组里没有就自然不命中 → 落到 `对战等待` → （interface.json 的
    //       任务级 override 注入）`部落战-乱丢-选牌` 随便丢一张 → 回本节点下一轮。
    //       2026-10-15 口径从「挂机等结束」改成「随便丢点就行」（用户原话）。
    //       圣水 < 1 时 `出牌-圣水够` 不命中 → `部落战-战斗中` 的 next 直接落
    //       `部落战-继续等` 干等，所以**没费不会乱丢**（不乱浪费点击）。
    //    ⚠️ 打完一张之后 `落点-*` / `对战等待` 的出口都被 interface.json 的
    //        任务级 override 接回**本节点**（它们默认是回「对战循环入口」= 天梯循环），
    //        所以在部落战里不会串到天梯链上去。
    //
    //    post_delay 300 + timeout 1500 ≈ 每轮 1.8 秒；max_hit 600 只是防止跑飞。
    //    ⚠️ **必须有个 DirectHit 兜底排在最后**（`部落战-继续等`）—— 2026-10-11 实机踩到：
    //       战斗刚结束、结算画面还没弹出来的那一两秒里，圣水条和手牌都不见了 ⇒
    //       `部落战-结算` 和 `出牌-圣水够` **同时不命中** ⇒ next 扫到 timeout（1.5 秒）⇒
    //       `PipelineTask bad next` → `invalid node id, handle error` → 整条任务 **Failed**
    //       （失败帧 `env/maapicli/debug/on_error/2026.10.11-16.01.29.78_部落战-战斗中.png`
    //       就是「剩余时间 0:00、手牌已消失」那一瞬）。
    //       补上兜底之后这一格永远有节点命中，就不会再判失败。
    "部落战-战斗中": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 300,
        "max_hit": 600,
        "timeout": 1500,
        "next": ["部落战-结算", "出牌-圣水够", "部落战-继续等"],
        "on_error": ["部落战-继续等"]
    },
    "部落战-继续等": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "post_delay": 500,
        "next": ["部落战-战斗中"]
    },
    // ⑪b 「乱丢」两个节点（2026-10-15 用户口径：「随机卡组随便丢点就行」）。
    //    接入点 = interface.json 里「部落战」任务对 `对战等待` 的 override：
    //    出牌-圣水够 认不出任何已知卡牌时 → `对战等待` → `部落战-乱丢-选牌`。
    //    所以只在**圣水 ≥ 1** 时才会走到，天然「没费不乱丢」。
    //    ⚠️ 点击矩形是官方协议语义：`target: [x,y,w,h]` = **矩形内随机选点**（中心概率高）。
    //       选牌矩形 [200,1060,460,85]：4 个卡槽实测 x166~692（2026-10-15 从实战帧
    //       量得：槽宽 ~131，中心 231/363/495/626），y 1060~1145 稳稳压在卡面上，
    //       左边「下一张」预览（x<160）、下面圣水条都不碰。随机落哪张算哪张。
    //       落点矩形 [280,600,160,180]：己方半场中央草地（河道下沿 y≈555、公主塔顶
    //       y≈760 且分居 x≈167/547、国王塔 x≈300-415 y≥860）—— 整块都是空地。
    //    ⚠️ max_hit 500：按每循环 ~2.7s、单局 5 分钟上限算，4 局合计 ~400 次够用；
    //       万一用光，override 的 next 还有 `部落战-战斗中` 兜底（不会 next 耗尽）。
    "部落战-乱丢-选牌": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Click", "param": {"target": [200, 1060, 460, 85]}},
        "post_delay": 300,
        "max_hit": 500,
        "next": ["部落战-乱丢-落点"]
    },
    "部落战-乱丢-落点": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Click", "param": {"target": [280, 600, 160, 180]}},
        "post_delay": 800,
        "max_hit": 500,
        "next": ["部落战-战斗中"]
    },
    // ⑫ 结算画面的「确定」（复用天梯那套 result_confirm 模板；部落战结算的按钮位置不同，
    //    所以这里**用识别框**点，不抄天梯的固定坐标）。
    "部落战-结算": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "anchors/result_confirm.png", "threshold": 0.8}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 3000,
        "next": ["部落战-收尾"],
        "on_error": ["部落战-收尾"]
    },
    // ⑬ 收尾：先点掉战后那个「确定」（点完会回到社交列表），再重新进部落战开下一局。
    //    ⚠️ 这个「确定」在页面最底部（实测 y 1195~1271、169x76），和天梯那个确定不是同一个按钮
    //       （result_confirm 在它上面只有 0.64），所以用 OCR 认字。
    "部落战-收尾": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 8000,
        // ⚠️ 顺序有讲究（2026-10-11 实测）：结算之后的落点有**两种**——
        //    ① 直接回到**部落战页**（那就接着开下一局：`部落战-主界面锚点`）；
        //    ② 回到**社交成员列表**（那要重新点顶部栏「部落战」：`部落战-找部落战入口`）。
        //    两种都得接上，否则打完一局就收工、后面的卡组永远打不到。
        "next": ["[JumpBack]关掉奖励弹屏", "部落战-点确认", "部落战-找部落战入口", "部落战-主界面锚点"],
        "on_error": ["部落战-收工"]
    },
    "部落战-点确认": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [250, 1180, 240, 100],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 3000,
        "max_hit": 6,
        "next": ["部落战-找部落战入口"],
        "on_error": ["部落战-找部落战入口"]
    },
    // ⑭ 排队超时：点「取消」收工。取消键是红底白字（用户截图里在屏幕下半部），
    //    用 OCR 认字 + 白字掩码，不用坐标。
    "部落战-取消排队": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "取消",
                "roi": [140, 720, 440, 220],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2000,
        "next": ["部落战-排队超时收工"],
        "on_error": ["部落战-排队超时收工"]
    },

    // ——— 两个收工节点：都按「完成」结束（用户口径：四个卡组打完 = 完成）———
    "部落战-收工": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "StopTask", "param": {}},
        "focus": {
            "Node.Action.Starting": {
                "content": "**部落战收工** —— 这轮没能再开一局：可能是 4 个卡组都打完/冷却中，也可能是对战气泡暂时不可用（别人正在打）。下次运行会再试。",
                "display": ["log"]
            }
        }
    },
    "部落战-排队超时收工": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "StopTask", "param": {}},
        "focus": {
            "Node.Action.Starting": {
                "content": "**搜不到对手**（排队满 3 分钟），已点取消、跳过部落战。",
                "display": ["log", "notification"]
            }
        }
    }
}
