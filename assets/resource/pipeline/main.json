{
    // 单独一个「只做启动准备、不往下打」的节点。
    // 为什么要单独拆：界面的任务列表里，「启动游戏」和「自动对战」原来是**共用**
    // `启动检查` 当入口的 —— 实测那种情况下「自动对战」在列表里不显示（通用 UI 会把
    // 入口重复的任务去掉）。参考实现 MaaYuan 的 41 个任务入口各不相同，所以照它来：
    //   启动游戏 -> 本节点（只准备就绪）
    //   自动对战 -> 启动检查（准备就绪 + 进入对战循环）
    "启动游戏": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CR.Boot"
    },
    "启动检查": {
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "CR.Boot",
        "next": [
            "对战循环入口"
        ]
    },
    "对战循环入口": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "对局数已达标",
            "结算界面",
            "登录页",
            "宝箱弹层",
            "对战中",
            "卡组页",
            "主界面",
            "匹配中",
            "未知界面处理"
        ]
    },
    "对局数已达标": {
        "recognition": "Custom",
        "custom_recognition": "CR.MatchesReached",
        "custom_recognition_param": {
            "matches": 1
        },
        "action": "StopTask"
    },
    "登录页": {
        "recognition": "TemplateMatch",
        "template": "anchors/cadpa.png",
        "threshold": 0.8,
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "检测到登录页 —— 停下来等你手动登录（微信 / QQ 授权不碰）",
                "display": [
                    "log",
                    "toast"
                ]
            }
        }
    }
}
