{
    // 本文件是 ProjectInterface V2 协议描述，告诉通用 UI（MFAAvalonia 等）
    // 这个项目要用哪些资源、有哪些任务可跑、各任务可以调什么参数。
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    //
    // 说明：本项目目前只做简体中文，所以界面文案直接写中文。
    // 以后要多语言：把要翻译的文案前面加 $ 前缀，再加 languages 字段指向
    // 翻译文件（扁平 key-value JSON）即可。
    "interface_version": 2,
    "name": "MaaCR",
    "title": "MaaCR · 皇室战争国服助手",
    // 界面里显示的图标。MFAAvalonia 的 IconHelper 只认这个字段（按数据目录解析），
    // 没写就会退回它自己内嵌的 logo.ico —— 这就是「换了 logo 但界面里没变」的原因。
    //
    // 特意用**深底**那张：浅色插画在 24px 的标题栏里会糊成一团白，深底才看得清。
    // 文件放在 assets/icon.png，发布包里由 tools/install.py 放到包根 ——
    // 开发时数据目录是 assets/、发布时是包根，相对路径 "icon.png" 两种布局都对得上。
    "icon": "icon.png",
    "version": "0.1.0",
    "license": "MIT",
    "github": "https://github.com/yu-echo/MaaCR",
    "description": "皇室战争国服（腾讯代理版）自动化助手：自动对战刷局，其余日常任务在移植中。\n\n基于 MaaFramework，界面由 MFAAvalonia 提供。\n\n⚠️ 目标是**快速刷完尽可能多的对局**（刷宝箱 / 对局时长 / 卡牌大师进度），**不是上分**。评估它好不好用请看**每局对战耗时**，不是胜率。",
    // 公告框左边那一栏很窄：文案一长就会被挤成一列一个字，所以这里只写一句话。
    "welcome": "第一次用之前请先看 README 的「使用前准备」。",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            // 截图会缩放到「短边 720」。国服皇室战争是 720x1280 竖屏，
            // 缩放比正好 1:1 —— 所以 image/ 里的模板与 pipeline 里的坐标
            // 都是按 720x1280 量的，改这里就必须重采模板 + 重标坐标。
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "国服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        // 路径相对 **interface.json 所在目录**（也就是 assets/）解析，所以是 ../
        // -u 强制无缓冲输出：不然长任务跑起来日志会长时间不刷新，看起来像卡死。
        "child_exec": "python",
        "child_args": [
            "../agent/main.py",
            "-u"
        ]
    },
    "pretask": {
        // 控制器建立**之前**执行：① 确认目标是本地模拟器而不是插着的真机；
        // ② 模拟器没在跑就自己拉起来。非零退出会中止启动，正好当闸门用。
        //
        // ⚠️ 这两行的写法是两个坑逼出来的，别顺手「简化」回去：
        //
        // 1) exec **不走 PATH 查找**。MFAAvalonia 把它当成「<数据目录>/resource/base」
        //    下的相对路径，直接 Path.Combine 拼接（v2.16.1 源码 MaaProcessor.cs：
        //    ReplacePlaceholder(preTask.Exec, ResourceBase)，而 ResourceBase =
        //    DataRoot/resource/base）。所以哪怕写成 "python"，拼出来的也是
        //    「…/resource/base/python」这样一个不存在的文件，启动即失败 ——
        //    官方文档说「可以直接写 python」，跟实现对不上。
        //    → 绕法：拿绝对路径的 cmd.exe 当壳，真正要跑的命令交给它，由 cmd 去 PATH 里找。
        //
        // 2) args 跟 exec **不是一个基准**：args 是按「工作目录」解析的，
        //    而工作目录同样是 resource/base。所以要从 assets/resource/base
        //    往上三层才回到仓库根。
        //
        // 另外 assets/resource/base/ 这个空目录本身也必须存在（见那里的 .gitkeep）：
        // 工作目录不存在的话，Process.Start 一样会报「目录名无效」。
        //
        // 发布包里这两行由 tools/install.py 改写成指向自带 Python 的版本。
        "name": "环境准备",
        "label": "环境准备（检查设备 + 启动模拟器）",
        "exec": "C:/Windows/System32/cmd.exe",
        "args": [
            "/c",
            "python",
            "../../../tools/preflight.py"
        ]
    },
    // ⚠️ 这里**故意不设顶层 group、task 里也不写 group**。
    // group 是 PI v2.4.0 才加的字段，「通用 UI」版本低一点就可能认不出来 ——
    // 实测踩过：任务列表里一个任务都不显示，只剩「全局设置」，看着像任务没了。
    // 参考实现 MaaYuan 也是平铺列的（它的界面正常），所以就照这个来。
    "task": [
        {
            "name": "启动游戏",
            "entry": "启动游戏",
            "default_check": true,
            "description": "先把游戏准备妥当，再跑别的任务。\n\n它会做三件事：\n· 把模拟器屏幕点亮 —— 屏幕黑着的时候它截出来的图是黑的，什么也认不出来，很容易被误当成「脚本坏了」。\n· 把游戏切到最前面，并且等到游戏画面真的出来了才往下走。\n· 如果当前不是游戏（比如你切到别的 App 了），它会停下来提醒你，不会乱点。\n\n它只负责「准备好」，不负责打局。"
        },
        {
            "name": "自动对战",
            "entry": "启动检查",
            "default_check": true,
            "description": "自动打对局：进游戏 → 出牌 → 打完一局 → 再开下一局，一直打到设定的局数。\n\n认不出画面时它会自己想办法：先试着退回主界面，还不行就重开游戏。\n\n⚠️ 它的目标是 **快速刷完尽可能多的局**（刷宝箱、对局时长、卡牌大师进度），**不是上分** —— 所以「输」是正常的。它好不好用要看 **每局耗时**，不是胜率。",
            "option": [
                "打几局",
                "对战策略"
            ]
        },
        {
            "name": "领商店免费项",
            "entry": "商店任务",
            "description": "打开商店，把「每日精选」里标着「免费」的卡领掉。\n\n它认的是「免费」这两个字，不是颜色 —— 所以卡片长什么样都无所谓，写着免费就会领。\n\n刷到「已收集！」就说明今天领完了，它会停下来，不会白翻下去。\n\n只领免费的：那个绿色「免费！」按钮是先认出来再点的，不会瞎点坐标误领要花宝石的卡。"
        },
        {
            "name": "部落捐赠",
            "entry": "部落任务",
            "description": "进部落聊天，把能捐的卡捐出去。\n\n只点亮绿色的「捐赠」按钮（这种能捐）；灰的是你自己发的请求，捐不了。点一下就直接捐了，不会再弹窗问你。\n\n捐完之后才点一次底部的「确定」—— 那是退出聊天的按钮，每捐一次都点它会直接退出来，所以只在最后点一下。",
            "option": [
                "捐几次"
            ]
        }
    ],
    "option": {
        "打几局": {
            "type": "input",
            "label": "最多打几局",
            "description": "打满这个局数就停。第一次跑建议就用 1，看着它打完一局再说。",
            "inputs": [
                {
                    "name": "局数",
                    "label": "局数",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "对局数已达标": {
                    "custom_recognition_param": {
                        "matches": "{局数}"
                    }
                }
            }
        },
        "对战策略": {
            "type": "select",
            "label": "对战策略",
            "description": "决定它攒多少圣水才出牌。\n\n· 稳健推进：攒到 8 圣水再出，中规中矩（默认）。\n· 有费就出：5 圣水就出，出得更勤，一局打得更快。\n· 攒满再推：攒满 10 才出，出得最少，但每次都是大单位。\n\n圣水越早花掉、回蓝越不浪费，所以「有费就出」通常刷局更快；「攒满再推」最慢，那只是旧脚本留下的习惯。",
            "default_case": "稳健推进",
            "cases": [
                {
                    "name": "稳健推进",
                    "pipeline_override": {
                        "对战中": {
                            "custom_action_param": {
                                "min_elixir": 8
                            }
                        }
                    }
                },
                {
                    "name": "有费就出",
                    "pipeline_override": {
                        "对战中": {
                            "custom_action_param": {
                                "min_elixir": 5
                            }
                        }
                    }
                },
                {
                    "name": "攒满再推",
                    "pipeline_override": {
                        "对战中": {
                            "custom_action_param": {
                                "min_elixir": 10
                            }
                        }
                    }
                }
            ]
        },
        "捐几次": {
            "type": "input",
            "label": "部落最多捐几次",
            "description": "一次进部落最多捐几次。\n\n当前这屏没有能捐的，它会往上翻聊天记录找，最多翻 8 屏。",
            "inputs": [
                {
                    "name": "次数",
                    "label": "次数",
                    "default": "4",
                    "pipeline_type": "int",
                    "verify": "^[1-9][0-9]*$",
                    "pattern_msg": "请填正整数"
                }
            ],
            "pipeline_override": {
                "部落捐赠": {
                    "custom_action_param": {
                        "donate_rounds": "{次数}"
                    }
                }
            }
        }
    },
    "setting": [
        {
            "name": "battle_setting",
            "label": "全局设置",
            "description": "对所有任务生效。",
            "option": [
                "对战策略"
            ]
        }
    ],
    "preset": [
        {
            "name": "日常一条龙",
            "description": "先把游戏准备好，再领商店免费项 + 部落捐赠，各跑一遍，跑完自动回主界面。",
            "task": [
                {
                    "name": "启动游戏",
                    "enabled": true
                },
                {
                    "name": "领商店免费项",
                    "enabled": true
                },
                {
                    "name": "部落捐赠",
                    "enabled": true
                }
            ]
        }
    ]
}
