{
    // ★ 纯战斗循环（2026-09-23 转纯 JSON，**没有任何自定义识别/动作**）。
    //
    // 三个关键设计，都对着官方《3.1-任务流水线协议》和真机标定数据：
    //
    // ① 圣水门槛用**位置竖条**，不用整条像素总数。
    //    标定实测：按总数分圣水是重叠的（8费 7832~13321、5费 0~9186，白字打空洞），
    //    而按位置取 6px 竖条是**完全二值**的：亮=174px、不亮=0px。
    //    x = 150 + (693-150) × N/10：
    //      5费 421 | 6费 475 | 7费 530 | 8费 584 | 9费 638 | 10费 690
    //    ⇒「圣水够 8 费」= roi [581,1230,6,40] + 洋红 + count >= 50
    //
    // ② 手牌不需要「每槽各是哪张」—— 同时只可能有 4 张。
    //    TemplateMatch 命中的框**就是那张牌的位置**，直接 Click(target=true) 就出牌，
    //    连槽位都不用算。**优先级 = next 的顺序**（协议：按顺序识别，只执行第一个命中的）。
    //    8 个节点覆盖 10 张模板（两张精英形态并进同节点的 template 列表）。
    //
    // ③ 落点：「塔破就放敌方半场深位」用 ColorMatch + inverse 判断血条消失。

    // ——— 门：确认「确实在对战画面」———
    // 必须同时满足：圣水条左端亮（1费位置）+ 手牌区至少认出一张牌。
    // 只看圣水条颜色不够 —— 开宝箱那种整屏紫粉的界面会让条区域一片亮。
    "对战中": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "圣水条",
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [201, 1230, 6, 40],
                                "method": 40,
                                "lower": [138, 70, 170],
                                "upper": [175, 255, 255],
                                "count": 50
                            }
                        }
                    },
                    {
                        "sub_name": "手牌",
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": [
                                    "cards/哥布林飞桶.png",
                                    "cards/飞龙宝宝.png",
                                    "cards/气球兵.png",
                                    "cards/武士.png",
                                    "cards/亡灵.png",
                                    "cards/狂暴樵夫.png",
                                    "cards/火精灵.png",
                                    "cards/骷髅兵.png",
                                    "cards/哥布林飞桶-进化.png",
                                    "cards/飞龙宝宝-进化.png"
                                ],
                                "roi": [108, 1011, 712, 1267],
                                "threshold": 0.85
                            }
                        }
                    }
                ]
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 600,
        "rate_limit": 400,
        "next": ["出牌-圣水够"],
        "on_error": ["对战等待"]
    },
    // ——— 圣水门槛 ———
    // ⚠️ 2026-09-29 修：这里原来是 [581,...]（**8 费**），于是每轮都要攒到 8 才进挑牌链，
    //    而链里第一个能出的是手里最贵的那张 —— 结果就是「每次只出一张最大的牌，
    //    1 费的牌永远轮不到」（用户实测反馈）。
    //    现在把门槛压到 **1 费**：只要够 1 费就进链，具体出哪张交给每个 `出-x` 节点
    //    自己的费用判据去筛（它们各自带一条「圣水 ≥ 这张牌的费用」的 ColorMatch）。
    //    这样才是注释里一直写的那个语义：「先出能出的最大牌，余费再补低费」。
    //    界面上的「对战策略」仍可把这行 x 改大（5 费 / 10 费）来故意攒费。
    "出牌-圣水够": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [201, 1230, 6, 40],
                "method": 40,
                "lower": [138, 70, 170],
                "upper": [175, 255, 255],
                "count": 50
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "next": [
            "出-气球兵",
            "出-武士",
            "出-狂暴樵夫",
            "出-飞龙宝宝",
            "出-哥布林飞桶",
            "出-亡灵",
            "出-火精灵",
            "出-骷髅兵",
            "对战等待"
        ]
    },
    // 气球兵（5 费）：热气球吊篮 + 骷髅。走**通用落点**（只有哥布林飞桶走「落点-飞桶」）。
