{
    // ★ 「认不出来的界面」—— 纯 JSON 版（2026-09-23）。
    //
    // 核心：**unknown = 一个已知界面都不匹配**。
    // 协议里没有 Not 类型，「非」只能用通用字段 `inverse`，
    // 所以这里用 `Or` 列出所有已知界面的锚点，再 `inverse: true`。
    //
    // ⚠️ 这一条不只是「更干净」—— 它是**收工路径能不能生效的前提**：
    //    之前这个节点是 DirectHit（永远命中），于是 `对战循环入口` 永远不会识别超时，
    //    「打够了」那个 on_error 一辈子走不到。改成真判断之后超时才可达。
    //
    // 兜底顺序（代价从低到高）：点底部导航回主界面 -> 当弹层点一下 -> 重启游戏。
    // 三者都试完（max_hit 用尽）就自然结束，不再原地打转。
    "未知界面处理": {
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "roi": [244, 934, 250, 64],
                                "method": 40,
                                "lower": [5, 90, 140],
                                "upper": [35, 255, 255],
                                "count": 8000
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {"template": "anchors/result_confirm.png", "threshold": 0.8}
                        }
                    },
                    {
                        // 开宝箱整屏橙屏 —— 它也是「一个已知界面」。
                        // ⚠️ 2026-09-24 换模板：原来用 chest_stars.png / chest_stars_b.png，
                        //    实测在三张真实橙屏截图上**最高只有 0.571**（阈值 0.85），即**从未命中过**，
                        //    等于这一项白写 —— 于是整屏橙屏会被判成「未知界面」，
                        //    兜底链就会去点导航/点弹层/重启游戏，把好好的开宝箱动画搅乱。
                        //    现在换成从橙屏实测裁出来的两个特征（同 battle.json「奖励宝箱」同源）：
                        //      chest_orange_stars.png  顶部两颗星   正样本 ≥0.9985 / 负样本 ≤0.5750
                        //      chest_orange_slots.png  底部4个「?」圈 正样本 ≥0.8163 / 负样本 ≤0.3038
                        //    数组即 Or 语义，两个特征互相兜底；阈值 0.8。
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["anchors/chest_orange_stars.png",
                                             "anchors/chest_orange_slots.png"],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {"template": "anchors/deck_slots.png", "threshold": 0.85}
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {"template": "anchors/cancel.png", "threshold": 0.8}
                        }
                    },
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                // ⚠️ 2026-09-30 修悬空引用：这里原来写的是 10 个哈希名
                                //    （`t_fb73fd20.png` 等）。那批文件已按**内容 md5 重命名**成
                                //    中文卡名（实测 10/10 内容逐字节一致，旧名就是「t_ + md5 前 8 位」），
                                //    旧名在仓库里已不存在 ⇒ 这一项会**永远认不到**。
                                //    这里换成新名字，语义完全不变（这一项要与 battle.json 的手牌
                                //    模板保持一致，两边用同一批卡面）。
                                "template": [
                                    "cards/哥布林飞桶.png", "cards/飞龙宝宝.png",
                                    "cards/气球兵.png", "cards/武士.png",
                                    "cards/亡灵.png", "cards/狂暴樵夫.png",
                                    "cards/火精灵.png", "cards/骷髅兵.png",
                                    "cards/哥布林飞桶-进化.png", "cards/飞龙宝宝-进化.png"
                                ],
                                "roi": [108, 1011, 712, 1267],
                                "threshold": 0.85
                            }
                        }
                    }
                ]
            }
        },
        "inverse": true,
        "action": {"type": "DoNothing", "param": {}},
        "next": ["未知-点导航", "未知-点弹层", "未知-重启"],
        "on_error": ["对战循环入口"]
    },
    // ① 底部导航还在 -> 点「对战」回主界面（卡在子页面的正解，最便宜）
    "未知-点导航": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {"template": "nav/battle.png", "roi": [0, 1140, 720, 140], "threshold": 0.6}
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2000,
        "max_hit": 40,
        "next": ["对战循环入口"],
        "on_error": ["未知-点弹层"]
    },
    // ② 当全屏弹层处理：点屏幕中间推进。严格限次，免得真卡住时乱点。
    "未知-点弹层": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Click", "param": {"target": [360, 540]}},
        "post_delay": 800,
        "max_hit": 60,
        "next": ["对战循环入口"]
    },
    // ③ 认不出来又推不动 -> 重启游戏（最贵但最确定）。
    // ⚠️ 用原生 StopApp/StartApp，不再需要自定义动作。
    //    纯 JSON 拿不到「画面是否定格」这个判据了（那要算帧间差），
    //    所以这里改成**限次**：重启 2 次还不行就自然结束，不无限重启。
    "未知-重启": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "StopApp",
            "param": {"package": "com.tencent.tmgp.supercell.clashroyale"}
        },
        "post_delay": 3000,
        "max_hit": 2,
        "next": ["未知-拉起"]
    },
    "未知-拉起": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "StartApp",
            "param": {"package": "com.tencent.tmgp.supercell.clashroyale"}
        },
        "post_delay": 3000,
        "next": ["对战循环入口"]
    }
}
