{
    // ★ 日常任务：纯 JSON 版。
    //
    // ══ 2026-09-24 实机重写：商店路径 + 滑动节奏 ══
    //
    // 真实路径（用户截图 1..5 指的「顺序」+ 本机逐步实测确认）：
    //   底部「商店」→ 左上「礼物盒」分类图标（把页面复位到超值推荐顶部）
    //   →「超值推荐」页签 → **慢速下翻 20 屏以上** →「每日精选」区
    //   → 点第一格的浅绿「免费！」卡 → 弹窗「获取宝石？」→ 点绿色「免费！」按钮
    //   → 卡片立刻变「已收集！」，弹窗自动关闭。
    //
    // 实测记录（MuMu 720x1280，2026-09-24 00:0x）：
    //   · 免费卡在「每日精选」**第一格**；点文字处即打开弹窗（实测点 (118,408) 命中）。
    //   · 弹窗确认键是**绿色「免费！」**（不是「领取」）；弹窗标题「获取宝石？」。
    //   · 领完宝石 8497 -> 8522（+25），**没有**「恭喜获得」二次弹窗要点。
    //   · 超值推荐页极长：连翻 30 屏仍是付费项/宝箱板块 —— 必须给足滑动预算。
    //   · 底部导航角标实测在 y 1155~1185，导航条起点约 y 1110（roi 用 1110 起）。
    //
    // ══ 用户明确反馈：滑动太快 OCR 认不出来 ══
    // 三层一起改：① duration 1200ms（慢拖，不是快甩，几乎不产生惯性）；
    //            ② `end_hold: 300` —— 到终点**先按住停 300ms 再抬手**，彻底消掉惯性滚动；
    //            ③ post_delay 1800 —— 等画面完全静止再让识别读，避免读到模糊帧。
    //
    // ══ 「翻到底就跳过」怎么落地 ══
    // 用 max_hit 当滑动预算。实测确认（maxhit 探针）——**max_hit 用尽的节点，
    // 在调用方的 `next` 和 `on_error` 两个列表里都会被跳过**。所以把终点节点排在
    // 预算节点后面即可：预算用完 -> 被跳过 -> 自动落到「商店扫到底」收工，不报错。
    // ⚠️ 纯 JSON 判不出「列表真的到底了」（没有帧间差能力），只能用**次数**近似。
    //    max_hit 60 × 每屏下移约 720px ≈ 覆盖 45~50 屏，足够越过实测的 20+ 屏。

    // 只做颜色二值化的辅助节点：游戏 UI 文字都是「白字 + 深色描边」，
    // 所以按「够白」筛一遍，就把底色/卡面整个忽略掉了。
    // ⚠️ 阈值要严（V≥225 且 S≤40）：宽松一点会把浅灰底整张卡算成白，掩码变实心块。
    //    实测「每日精选」免费卡的浅绿底 S≈43~58%，正好被 S≤40 挡在外面，白字能干净留下。
    // 它自己不参与流程，只被 OCR 的 color_filter 引用（协议：只取 method/lower/upper）。
    "白字掩码": {
        "recognition": {
            "type": "ColorMatch",
            "param": {
                "roi": [0, 0, 1, 1],
                "method": 40,
                "lower": [0, 0, 225],
                "upper": [180, 40, 255],
                "count": 1
            }
        },
        "action": {"type": "DoNothing", "param": {}}
    },

    // ——— 商店 ———
    // 入口只挂「环境准备」：它是 DirectHit、永远命中，会走完整条启动链。
    // 启动链之后去哪儿由 interface.json 的任务级 override 注入（-> 商店去商店页）。
    "商店任务": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["环境准备"]
    },
    // ① 进商店页：点底部导航的「商店」。
    // ⚠️ 模板是**未选中**态（nav/shop.png）。已经在这一页时底部显示的是选中态
    //    （icon 变亮/放大），这个节点就匹配不上 —— 正好，不会重复点。
    //    匹配不上也没关系：on_error 直接接到下一步，路径不断。
    // ⚠️ roi [0,1140,720,140] 是**上一轮真机已跑通**的取值，故意不动。
    "商店去商店页": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/shop.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["商店进礼物盒"],
        "on_error": ["商店进礼物盒"]
    },
    // ② 点左上「礼物盒」分类图标 —— 用户截图第 2 张。
    // 它的作用不是「领礼物」，而是**把商店页复位到「超值推荐」的顶部**：
    // 实测点一下之后页面回到顶部（创作者代码横幅那一屏），这样下面「翻 20+ 屏找每日精选」
    // 才是从确定的位置出发的。已经在礼物分类时再点一次是幂等的。
    // ⚠️ 模板只裁了**盒身**（不含单元格底色）：礼物盒被选中时单元格底是浅蓝、
    //    未选中时是深蓝，连带底色一起裁会在另一种状态下匹配不上。
    "商店进礼物盒": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/gift_icon.png",
                "roi": [0, 80, 720, 170],
                "threshold": 0.8
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 3000,
        "next": ["商店选超值推荐"],
        "on_error": ["商店选超值推荐"]
    },
    // ③ 确保停在「超值推荐」页签 —— 用户截图第 3 张。
    // 页签行是**固定表头**（不随列表滚动），所以这一步任何滚动位置都能命中。
    // 已经是选中态时再点一次是幂等的。
    "商店选超值推荐": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "超值推荐",
                "roi": [0, 170, 720, 150],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["商店扫屏"],
        "on_error": ["商店扫屏"]
    },
    // ④ 扫屏：短超时看这一屏有没有可领的（免费 / 维护）。
    // ⚠️ 写法要点：被念到的节点若识别不到，会**在 next 列表里循环重试直到 timeout**，
    //    所以才要把「扫屏」做成短超时的哨兵、把「滑动」放在 on_error 里 ——
    //    反过来的话每屏要空等 20 秒才滑。
    // ⚠️ on_error 顺序 = 「滑动 -> 收工」：滑动是 DirectHit 一定命中，收工只在预算用尽后轮到。
    "商店扫屏": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1500,
        "next": ["商店领免费项", "商店领维护礼"],
        "on_error": ["商店滑一屏", "商店扫到底"]
    },
    // 领「每日免费礼物」：用**原色模板**认「免费！」那两个字。
    // 为什么不用 OCR：这两个字是「白字 + 深色描边」，压在浅绿卡面上，
    // 白字掩码的 S≤40 与卡面绿的 S≈43% 只差一点点，靠得太近；
    // 而模板是直接从真机卡面裁的（底色 (97,237,152) 与实测卡面 (93,221,140) 一致），
    // 颜色/字号完全对得上，更稳。
    // ⚠️ roi 只框**左列**：免费卡固定是「每日精选」第一格（左列），
    //    这样不会去匹配列表里其他地方同样写着「免费」的小字。
    // ⚠️ target_offset 往上挪 150px：文字写在卡片**底部**，直接点文字有概率点到
    //    卡片下沿或网格缝隙（旧版「点了没反应」就是这么来的）；-150 仍落在卡身内。
    // ⚠️ timeout 给 8 秒：这是**点完之后等弹窗**的预算，比「扫屏」长得多。
    "商店领免费项": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/free_label.png",
                "roi": [0, 240, 260, 800],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true,
                "target_offset": [0, -150, 0, 0]
            }
        },
        "timeout": 8000,
        "next": ["商店确认免费"],
        "on_error": ["商店扫屏"]
    },
    // 领「维护礼物」：维护补偿只在维护后出现，平时扫不到 —— 扫不到就顺着流程继续翻，
    // 翻到底也没有就静默跳过（用户要求「两个拉到底都识别不到自动跳过」）。
    // ⚠️ 未实机验证：本机当前账号没有维护礼物，无法确认它的确切文案/位置。
    //    这里按最保守的做法：全列表区 OCR 认「维护」，命中才点。若实测发现它是别的叫法
    //    （如「维护补偿」），改 expected 即可。
    "商店领维护礼": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "维护",
                "roi": [0, 240, 720, 800],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "timeout": 8000,
        "next": ["商店确认免费"],
        "on_error": ["商店扫屏"]
    },
    // 弹窗里的绿色「免费！」确认键 —— 这个必须用**原色模板**。
    // 为什么不能盲点固定坐标：弹窗内容随当日免费项变（宝石/宝箱/卡牌），
    // 点错会按到隔壁那张要花宝石的卡上。「先认出再点」是硬要求。
    // 点完（无论出没出弹窗）都回「商店扫屏」，不在这里判断成败。
    "商店确认免费": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "shop/free_confirm.png",
                "roi": [0, 520, 720, 560],
                "threshold": 0.85
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["商店扫屏"],
        "on_error": ["商店扫屏"]
    },
    // 往下滑一屏。max_hit 60 = 滑动预算（沿用旧版的 SHOP_IDLE_LIMIT = 60）；
    // 用完就在「商店扫屏」的 on_error 里被跳过 -> 落到「商店扫到底」。
    // ⚠️ 滑动参数就是用户点名的那个问题：「滑动太快 ocr 识别可能不好」。
    //    这里 duration 1200 + end_hold 300 + post_delay 1800 三件套：
    //    慢拖不甩、到终点先按住再抬手、停稳 1.8 秒后才让识别看。
    // ⚠️ 起点 y=1060 落在列表内、终点 y=340 在页签行下沿，单次下移约 720px。
    // ⚠️ on_error 回「商店扫屏」而不是直接收工：实测撞到过 adb 瞬时故障
    //    （`child exit with 255`，`input swipe` 失败），一次失败就把扫描掐了 ——
    //    而这条流程的全部意义就是「翻到底」。失败就重试，次数照样由 max_hit 兜住：
    //    每失败一次就消耗一次预算，用满 60 次自然落到「商店扫到底」，不会死循环。
    "商店滑一屏": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [360, 1060, 1, 1],
                "end": [[360, 340, 1, 1]],
                "duration": 1200,
                "end_hold": 300
            }
        },
        "post_delay": 1800,
        "max_hit": 60,
        "next": ["商店扫屏"],
        "on_error": ["商店扫屏"]
    },
    // 终点：滑动预算用完 -> 「商店滑一屏」被跳过 -> 落到这里。
    // 这里**不报错**，只记一句然后收尾回主界面 —— 就是「扫不到就跳过」。
    // （focus 只在带界面的客户端里显示；MaaPiCli 不处理 focus 回调。）
    // ⚠️ 旧版这里前面还挂过一个「已收集！」提前收工节点，这版**删掉了**：
    //    用户要求「每日免费礼物 / 维护礼物 两个都拉到底，识别不到自动跳过」，
    //    而「已收集！」当天领完就会常驻屏上，一旦用它提前收工，
    //    排在更下面的「维护礼物」永远扫不到。
    "商店扫到底": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "focus": "商店翻到底了，没有可领的免费项 —— 跳过",
        "next": ["收尾回主界面"]
    },

    // ——— 部落 ———
    "部落任务": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "next": ["环境准备"]
    },
    // 进部落聊天：先点底部「社交」，再点顶部「聊天」入口。
    // 分工两个节点是因为中间要等一下页面切过去。
    "部落进入聊天": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/social.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "next": ["部落点聊天入口"],
        "on_error": ["部落点聊天入口"]
    },
    "部落点聊天入口": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Click", "param": {"target": [547, 202]}},
        "post_delay": 3000,
        "next": ["部落扫屏"]
    },
    // 和商店同构：短超时扫一屏，有可捐的就捐；没有就翻页。
    "部落扫屏": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1200,
        "next": ["部落捐一个"],
        "on_error": ["部落翻页", "部落扫到底"]
    },
    // 捐一个：OCR 认「捐赠」两个字 -> 点它，**点一下就直接捐出**，没有二次确认弹窗。
    // ⚠️ max_hit 是**上限**：由界面上的「最多捐几个请求」用 pipeline_override 注入。
    //    纯 JSON 判不了「按钮亮着还是灭的」（那看的是底色饱和度），
    //    所以暗着的按钮点了也不会捐出去，只是白点一下 —— 用 max_hit 兜住次数。
    // ⚠️ timeout 给 900ms：点完继续在同屏找下一个「捐赠」；找不到就超时去翻页。
    "部落捐一个": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "捐赠",
                "roi": [0, 60, 720, 1050],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "timeout": 900,
        "max_hit": 1,
        "next": ["部落捐一个"],
        "on_error": ["部落翻页"]
    },
    // 当前屏没有可捐的：往下拖 = 聊天记录往上翻，找更早的请求。
    // max_hit 8 = 翻页预算，对着文档的 DONATE_LOOK_SCREENS = 8；
    // 用完就被跳过 -> 落到「部落扫到底」收工。
    // on_error 同商店：滑失败就重试，别让一次 adb 故障把翻页掐了。
    "部落翻页": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [360, 300, 1, 1],
                "end": [[360, 800, 1, 1]],
                "duration": 800
            }
        },
        "post_delay": 1500,
        "max_hit": 8,
        "next": ["部落扫屏"],
        "on_error": ["部落扫屏"]
    },
    "部落扫到底": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "focus": "部落聊天翻到底了，没有可捐的请求 —— 跳过",
        "next": ["部落退出聊天"]
    },
    // 捐完才点一次底部的「确定」—— 那是**退出聊天**的按钮。
    // ⚠️ 每捐一次都点它会直接退出来，永远捐不了第二次，所以只在最后点一下。
    // ⚠️ 为什么不能用「收尾回主界面」直接切页：聊天子页里底部导航条被输入条
    //    （请求换卡 / 友谊战…）和这个「确定」盖住，nav/battle.png 匹配是 0.00。
    //    所以先把这个「确定」点掉、露出导航条，再走收尾。
    //    ⚠️ 未实机验证：聊天页「确定」的具体位置只从旧文档得知「在底部」，
    //       如果实测点不中，就把 roi 收紧到实测位置。
    "部落退出聊天": {
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": "确定",
                "roi": [150, 1050, 420, 220],
                "threshold": 0.3,
                "color_filter": "白字掩码"
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2000,
        "timeout": 3000,
        "next": ["收尾回主界面"],
        "on_error": ["收尾回主界面"]
    },

    // 收尾：回主界面（点底部导航「对战」）。
    // 和 base.json 的「回主界面」是同一套判据，区别是**这里没有 next** ——
    // 日常任务跑完就该结束，别跳进对战循环。（协议：next 为空 = 任务终止。）
    "收尾回主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/battle.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2000
    }
}
