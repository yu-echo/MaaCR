    //      → And 命中 box (247,888,61,36)，正落在按钮正中。
    //      ⇒ 下面这些区间/阈值就是标定值，别再凭感觉改。
    //    ⚠️ 唯一没跑的一步是**真的点下去**（那会消耗掉当天的请求）——点击动作本身
    //       和 `部落关请求弹窗` 用的是同一个 `Click target:true`，那条已经实机验过。
    "部落请求卡牌": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "clan/request_card_label.png",
                "roi": [63, 1067, 104, 36],
                "threshold": 0.8
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        // 点完只等弹窗；等不到就走 on_error，别在这儿耗默认的 20 秒。
        "timeout": 6000,
        "next": ["部落请求弹窗"],
        "on_error": ["部落关请求弹窗", "部落退出聊天", "收尾回主界面"]
    },
    // 弹窗开着的判据（= 右上角关闭键在）。动作什么都不做，只是「确认到了这一步」。
    "部落请求弹窗": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "clan/request_popup_close.png",
                "roi": [600, 100, 120, 100],
                "threshold": 0.8
            }
        },
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 3000,
        "next": ["部落请求回顶"],
        "on_error": ["部落关请求弹窗", "部落退出聊天", "收尾回主界面"]
    },
    // ⚠️ 弹窗关掉再打开**不会**回到列表顶部（2026-09-27 实测：重开后第一屏和上次的顶部对不上），
    //    所以必须先滚回顶部，否则「要找的卡在顶部」时会一路往下滚到放弃。
    //    ⚠️ 起手点必须在**网格内**（y=520）：实测从横幅上（y=400）起手列表根本不滚。
    //    ⚠️ 12 次是算出来的：列表总高约 5700px，这种滑法一次约 900~1100px，要留足余量。
    "部落请求回顶": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Swipe", "param": {"begin": [195, 520], "end": [195, 1150], "duration": 500}},
        "repeat": 12,
        "repeat_delay": 400,
        "post_delay": 600,
        "next": ["部落请求找卡"],
        "on_error": ["部落请求找卡"]
    },
    // 找卡的「一屏」——和「部落扫屏」同构：自己永远命中，靠 next 里的长按节点是否命中决定去向。
    // 长按没命中 → 本节点 next 耗尽 + timeout → on_error 翻页；翻页次数用完 → 放弃找卡。
    "部落请求找卡": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "timeout": 1500,
        "next": ["部落长按目标卡"],
        "on_error": ["部落翻请求页", "部落放弃找卡"]
    },
    // 长按目标卡：认**卡面**，不是认坐标 —— 卡在网格里按游戏自己的顺序排，
    // 位置会随升级/新卡变动，写死格子迟早会按错。
    // 长按（不是点击）才会弹出「信息 / 请求」那个气泡；时长 800ms 是实测惯用值。
    // ★ 要长按哪张卡由界面选项「要请求的卡牌」注入 —— 选项会把这张模板替换掉
    //   （`recognition.param.template`，pipeline_override 是深合并，只换模板、roi 与阈值保留）。
    // ⚠️ roi 必须框住**全部 4 列**（老版本写 590 宽，第 4 列卡面右沿被切掉，那一列永远认不到）
    //    以及整个列表视口（y 395..1165）—— 卡的纵向位置会随弹窗横幅高度变化。
    // ⚠️ 阈值 0.93：2026-09-27 把 93 张卡面在 32 张实机帧上互验（搜索范围就是下面这个 roi）——
    //    正样本最低 1.0000、负样本最高 0.8712（部分可见的卡面造成的假命中），两边各留 ~0.06。
    //    别往下调：假命中会让脚本长按**错的卡**，而错的卡一样有橙色「请求」按钮，
    //    后面那一步拦不住它 —— 会真的把请求发出去。
    "部落长按目标卡": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "clan/request_card_target.png",
                "roi": [20, 395, 680, 770],
                "threshold": 0.93
            }
        },
        "action": {"type": "LongPress", "param": {"target": true, "duration": 800}},
        "post_delay": 1500,
        "timeout": 3000,
        "next": ["部落点请求"],
        // 只对应「认到了但长按失败」；认不到由 `部落请求找卡` 的 on_error 接管。
        "on_error": ["部落关请求弹窗", "部落退出聊天", "收尾回主界面"]
    },
    // 往上滑一小步，继续找。
    // ★ 步长必须**小于一屏 3 行**，否则有的行会「从两次滑动之间跳过去」而永远看不到
    //   （2026-09-27 实测：550px 的滑动惯性大、一步跳 3 行以上，电击法术这种第 3 行的卡会漏掉）。
    //   这里 250px / 900ms 慢滑，实测一步约 1.5 行 —— 相邻两屏重叠 1.5 行，不会跳行。
    // max_hit 30 × 1.5 行 = 45 行 > 列表 25 行，够翻完；用完则该节点被 next 跳过，
    // 于是 `部落请求找卡` 的 on_error 落到 `部落放弃找卡`。
    "部落翻请求页": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "Swipe", "param": {"begin": [195, 950], "end": [195, 700], "duration": 900}},
        "max_hit": 30,
        "post_delay": 800,
        "next": ["部落请求找卡"]
    },
    // 兜底：整张列表翻完也没找到要请求的那张卡 —— 跳过这一步，正常收尾。
    "部落放弃找卡": {
        "recognition": {"type": "DirectHit", "param": {}},
        "action": {"type": "DoNothing", "param": {}},
        "focus": "弹窗里没找到要请求的那张卡 —— 跳过请求，继续收尾",
        "next": ["部落关请求弹窗", "部落退出聊天", "收尾回主界面"]
    },
    // 气泡里的「请求」按钮 —— 和「部落捐一个」同一套写法：**先找橙色块，再在橙块里读字**。
    // 两步缺一不可：只看颜色会被卡面上的橙色（比如火枪手的头发）骗到；
    // 只看文字则可能读到别处的「请求」二字（弹窗说明文字里有「可请求捐赠卡牌数」）。
    // `box_index: 1` 取 OCR 那一项的框 = 真正写着「请求」的那个橙按钮。
    //
    // 橙色区间标定（用用户发的弹窗截图量的 —— 色彩不受截图压缩影响）：
    //   · 气泡里「请求」按钮实测中位 HSV=(21,212,255)、框约 168x68、填充 ~10000 像素
    //   · 和底部「请求卡牌」按钮实测的 (21,211,255) **完全一致**，就是同一套橙
    //   ⇒ 取 H[14,30] S≥150 V≥190；`count: 4000` 卡在「按钮 ~10000」和
    //     「卡面里的橙色小块 ~1700」之间，把卡面残块筛掉。
    // ⚠️ 换到真实 720p 帧上复算校准要等冷却结束（截图是 0.72 倍缩放的，面积只是估算）。
    "部落点请求": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "sub_name": "btn",
                        "recognition": "ColorMatch",
                        // ⚠️ x 宽度 620 → 680：气泡跟着长按点走，第 4 列（x 531~678）的卡
                        //    长按后「请求」按钮会落在 x>620 的位置，老区间框不住。
                        "roi": [20, 150, 680, 1010],
                        "method": 40,
                        "lower": [14, 150, 190],
                        "upper": [30, 255, 255],
                        "count": 4000,
                        "connected": true
                    },
                    {
                        // ⚠️ 阈值 0.6 是**卡着**定的：弹窗开着时底下那个橙色按钮已经
                        //    被弹窗盖住，但万一盖不住，它的字是「请求换卡」，
                        //    与「请求」的相似度 = 1 - 2/4 = 0.5 < 0.6，会被挡掉。
                        "recognition": "OCR",
                        "roi": "btn",
                        "expected": "请求",
                        "threshold": 0.6
                    }
                ],
                "box_index": 1
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2500,
        "timeout": 3000,
        // 请求成功弹窗会自己关掉。**必须走「部落退出聊天」再回主界面** ——
        // 实测：这种聊天子页的底部导航条被「确定」那一行盖住，直接认 nav/battle.png
        // 只有 0.2516，会判失败；先点掉「确定」露出导航条才行（和「部落扫到底」tails 同一套）。
        "next": ["部落退出聊天", "收尾回主界面"],
        "on_error": ["部落关请求弹窗", "部落退出聊天", "收尾回主界面"]
    },
    // 兜底：把「选择您想要的卡牌」弹窗关掉，让后面的「收尾回主界面」能点到导航条。
    // 只在上面任何一步失败时才轮到它 —— 它能命中说明弹窗还开着。
    "部落关请求弹窗": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "clan/request_popup_close.png",
                "roi": [600, 100, 120, 100],
                "threshold": 0.8
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 1500,
        "timeout": 2000,
        // 同上：先退聊天（点「确定」露出导航条）再回主界面。
        "next": ["部落退出聊天", "收尾回主界面"],
        "on_error": ["部落退出聊天", "收尾回主界面"]
    },

    // 收尾：回主界面（点底部导航「对战」）。
    // 和 base.json 的「回主界面」是同一套判据，区别是**这里没有 next** ——
    // 日常任务跑完就该结束，别跳进对战循环。（协议：next 为空 = 任务终止。）
    "收尾回主界面": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "nav/battle.png",
                "roi": [0, 1140, 720, 140],
                "threshold": 0.6
            }
        },
        "action": {"type": "Click", "param": {"target": true}},
        "post_delay": 2000
    }
}
